function startPolling() {
  var lastHash = null;
  function hashStr(s) {
    var h = 5381;
    for (var i = 0; i < s.length; i++) { h = ((h << 5) + h + s.charCodeAt(i)) | 0; }
    return h;
  }
  function refreshLoop() {
    fetch(DATA_URL, { cache: 'no-store' }).then(function (r) { return r.text(); }).then(function (text) {
      var h = hashStr(text);
      if (h === lastHash) return;
      lastHash = h;
      DATA = JSON.parse(text);
      buildHeader();
      buildBoard();
      if (openDetailId && CARD_INDEX[openDetailId]) {
        openDetail(openDetailId, true);
      } else if (openDetailId) {
        closeDetail();
      }
    }).catch(function () { /* 网络抖动：静默跳过这一轮 */ });
  }
  timer = setInterval(refreshLoop, 3000);
}

