def compute_project_activity(cfg, worktrees, project_root):
    """项目级最近动静 = max(各 worktree HEAD commit 时间, changes/backlog 数据源 max-mtime)。"""
    stamps = []
    for wt in worktrees:
        stamps.append(run_git(["log", "-1", "--format=%cI"], cwd=wt["path"]).strip() or None)
        mtime = tree_max_mtime(Path(wt["path"]) / cfg["doc_root"] / "changes")
        stamps.append(iso_seconds(mtime) if mtime else None)
    if project_root:
        mtime = tree_max_mtime(Path(project_root) / "backlog")
        stamps.append(iso_seconds(mtime) if mtime else None)
    return max_activity(*stamps)


def build_data(cfg):
    warnings = []
    anchor = cfg["repo_root"]
    worktrees = list_worktrees(anchor)
    main_wt = worktrees[0]

    changes = scan_all_changes_split(cfg, worktrees, warnings, base_worktree=main_wt["path"])
    for rec in changes:
        for r in [rec] + list(rec.get("forks") or []):
            probe_change_artifacts(r, cfg["doc_root"])
            compute_change_git_stats(r, cfg["doc_root"], main_wt["path"])
            compute_gates(r, cfg["doc_root"], warnings)
            attach_card_progress(r, warnings)
    changes.sort(key=lambda c: (c.get("seq") is None, c.get("seq") or 0))

    if cfg["mode"] == "vault":
        project_root = cfg.get("project_root")
    else:
        project_root = str(Path(main_wt["path"]) / ".eo-project")

    roadmap = read_roadmap(project_root, warnings)
    backlog_cards, backlog_archive = scan_backlog_all(cfg, worktrees, warnings)
    direct_commits = compute_monthly_direct_commits(anchor)

    active_changes = [c for c in changes if c["status"] != "archived"]
    stale_changes = [c for c in changes if c.get("stale")]
    blocked_changes = [c for c in changes if c.get("blocker")]

    return {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "activity_at": compute_project_activity(cfg, worktrees, project_root),
        "serve": False,
        "project": {
            "name": cfg["project_name"],
            "mode": cfg["mode"],
            "project_root": project_root,
            "doc_root": cfg["doc_root"],
            "board_enabled": bool(cfg["board"].get("enabled")),
            "github_issue": bool(cfg["github"].get("issue")),
            "github_pr": cfg["github"].get("pr") or "never",
        },
        "roadmap": roadmap,
        "worktrees": [
            {"path": w["path"], "branch": w.get("branch"), "name": Path(w["path"]).name, "is_main": w is main_wt}
            for w in worktrees
        ],
        "scanned_worktrees": len(worktrees),
        "changes": changes,
        "backlog": backlog_cards,
        "backlog_archive": backlog_archive,
        "stats": {
            "active_changes": len(active_changes),
            "backlog_count": len(backlog_cards),
            "direct_commits": direct_commits,
            "stale_count": len(stale_changes),
            "blocked_count": len(blocked_changes),
        },
        "warnings": warnings,
    }


