function bindDetailTabs(container, initialTab) {
  var tabs = container.querySelectorAll('.detail-tab');
  var panes = container.querySelectorAll('.detail-pane');
  if (!tabs.length) return;
  function activate(id) {
    var exists = false;
    for (var t = 0; t < tabs.length; t++) {
      if (tabs[t].getAttribute('data-tab') === id) { exists = true; break; }
    }
    if (!exists) id = 'overview';
    for (var i = 0; i < tabs.length; i++) {
      var on = tabs[i].getAttribute('data-tab') === id;
      tabs[i].classList.toggle('active', on);
      tabs[i].setAttribute('aria-selected', on ? 'true' : 'false');
    }
    for (var j = 0; j < panes.length; j++) {
      panes[j].classList.toggle('active', panes[j].getAttribute('data-pane') === id);
    }
  }
  for (var k = 0; k < tabs.length; k++) {
    (function (tab) {
      tab.addEventListener('click', function () { activate(tab.getAttribute('data-tab')); });
    })(tabs[k]);
  }
  if (initialTab) activate(initialTab);
}

