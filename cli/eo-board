  searchInput.addEventListener('input', function () { activeSearchIndex = 0; renderSearchResults(); });
  keyHandler = function (e) {
    var searchOpen = searchBackdrop.classList.contains('open');
    if (e.key === 'Escape') {
      if (searchOpen) { e.preventDefault(); closeSearch(); return; }
      if (projectSwitcherOpen()) { e.preventDefault(); closeProjectSwitcher(); projectSwitcherTrigger.focus(); return; }
      if (drawer.classList.contains('open')) { e.preventDefault(); closeDetail(); return; }
      if (locatedKey) { e.preventDefault(); clearLocate(); }
