def probe_change_artifacts(rec, doc_root):
    # 存在性只做卡面小标签用；精确的轮次/结论/卡点见 gates（compute_gates）
    dir_path = Path(rec["worktree"]) / doc_root / "changes" / rec["dirname"]
    rec["artifacts"] = {
        "review": {"exists": (dir_path / "review.md").is_file()},
        "test": {"exists": (dir_path / "test.md").is_file()},
        "change_review": {"exists": (dir_path / "change-review.md").is_file()},
    }


def compute_change_git_stats(rec, doc_root, main_worktree_path):
    slug = rec["id"]
    wt_path = rec["worktree"]
    out = run_git(["log", "--all", "--oneline", "--fixed-strings", "--grep", f"[{slug}]"], cwd=wt_path)
    rec["commit_count"] = len([l for l in out.splitlines() if l.strip()])

    rel_dir = str(Path(doc_root) / "changes" / rec["dirname"])
    last_out = run_git(["log", "--all", "-1", "--format=%cI", "--", rel_dir], cwd=wt_path).strip()
    if last_out:
        rec["last_touch"] = last_out[:10]
    else:
        dir_path = Path(wt_path) / rel_dir
        mtimes = [p.stat().st_mtime for p in dir_path.rglob("*") if p.is_file()] if dir_path.is_dir() else []
        rec["last_touch"] = (
            datetime.fromtimestamp(max(mtimes)).strftime("%Y-%m-%d") if mtimes else rec.get("created")
        )

    rec["stale"], rec["stale_days"] = False, None
    if rec["tier"] == "light" and rec["status"] != "archived" and rec.get("last_touch"):
        try:
            dt = datetime.strptime(rec["last_touch"], "%Y-%m-%d").date()
            days = (date.today() - dt).days
            if days > STALE_DAYS_THRESHOLD:
                rec["stale"], rec["stale_days"] = True, days
        except ValueError:
            pass

    rec["is_default_worktree"] = Path(wt_path).resolve() == Path(main_worktree_path).resolve()
    rec["worktree_name"] = Path(wt_path).name


