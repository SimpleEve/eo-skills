# --serve 专用：每项目一个进程内缓存槽（新鲜度键 → build_data 结果），不落盘。
# 重建按槽单飞：同槽并发 miss 只允许一个线程扫描，不同槽互不阻塞。
_BOARD_CACHE = {}
_BOARD_CACHE_LOCK = threading.Lock()
_BOARD_BUILD_LOCKS = {}


def _cache_lookup(slot, key, cfg):
    with _BOARD_CACHE_LOCK:
        cached = _BOARD_CACHE.get(slot)
        if cached is not None and cached[0] == key:
            print(f"[eo-board] cache hit（{cfg['project_name']}）", file=sys.stderr)
            return cached[1], cached[2]
    return None


def _get_board_entry_cached(cfg):
    """返回 (data, built_at)。built_at 是数据实际构建时刻——命中缓存时保持不变，供聚合 as-of 使用。"""
    slot = str(cfg["config_path"])
    key = compute_freshness_key(cfg)
    hit = _cache_lookup(slot, key, cfg)
    if hit is not None:
        return hit
    with _BOARD_CACHE_LOCK:
        build_lock = _BOARD_BUILD_LOCKS.setdefault(slot, threading.Lock())
    with build_lock:
        # 排队期间前一持有者可能已建好；键重算保证旧键构建不会覆盖更新的槽内容
        key = compute_freshness_key(cfg)
        hit = _cache_lookup(slot, key, cfg)
        if hit is not None:
            return hit
        data = build_data(cfg)
        data["serve"] = True
        built_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with _BOARD_CACHE_LOCK:
            _BOARD_CACHE[slot] = (key, data, built_at)
        print(f"[eo-board] cache miss，已重扫（{cfg['project_name']}）", file=sys.stderr)
        return data, built_at


def get_board_data_cached(cfg):
    return _get_board_entry_cached(cfg)[0]


class BoardRequestHandler(http.server.BaseHTTPRequestHandler):
    cfg = None

    def log_message(self, fmt, *a):
        pass  # 静默：只读服务不需要逐请求刷屏

    def _send(self, status, content_type, body_bytes, message=None):
        # message 会被 http.server 按 latin-1 编码进状态行，只能传 ASCII；中文说明一律走 body。
        self.send_response(status, message)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body_bytes)))
        self.end_headers()
        self.wfile.write(body_bytes)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            data = get_board_data_cached(self.cfg)
            self._send(200, "text/html; charset=utf-8", render_html(data).encode("utf-8"))
        elif path == "/data.json":
            data = get_board_data_cached(self.cfg)
            self._send(200, "application/json; charset=utf-8", json.dumps(data, ensure_ascii=False).encode("utf-8"))
        elif path == "/favicon.ico":
            # 页面已经内嵌 data-URI favicon；这里单纯不让浏览器的随手请求落进 404 分支
            self.send_response(204)
            self.end_headers()
        else:
            body = f"未找到：{path}".encode("utf-8")
            self._send(404, "text/plain; charset=utf-8", body, message="Not Found")


def safe_open(url):
    try:
        webbrowser.open(url)
    except Exception:
        pass


def cmd_serve(cfg, args):
    handler = type("Handler", (BoardRequestHandler,), {"cfg": cfg})
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    except OSError as e:
        die(f"❌ 无法监听 127.0.0.1:{args.port}（{e}）——换个 --port 试试")
    url = f"http://127.0.0.1:{args.port}/"
    print(f"eo-board 只读服务已启动：{url}（Ctrl+C 停止）")
    if not args.no_open:
        threading.Timer(0.3, safe_open, args=(url,)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n已停止。")
        server.shutdown()


