def build_all_serve_data(scan_dir):
    """serve 逐请求聚合：每次重读注册表、逐项目走缓存槽。注册表级错误落 error 字段行内呈现，不 5xx。"""
    try:
        agg = build_all_data(scan_dir=scan_dir, get_entry=_get_board_entry_cached)
    except ConfigError as e:
        agg = {
            "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
            "serve": False,
            "registry_path": str(registry_path()),
            "reg_count": 0,
            "scanned_count": 0,
            "rows": [],
            "error": str(e),
        }
    agg["serve"] = True
    return agg


class AllBoardRequestHandler(http.server.BaseHTTPRequestHandler):
    scan_dir = None

    def log_message(self, fmt, *a):
        pass  # 静默：只读服务不需要逐请求刷屏

    def _send(self, status, content_type, body_bytes, message=None):
        self.send_response(status, message)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body_bytes)))
        self.end_headers()
        self.wfile.write(body_bytes)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            data = build_all_serve_data(self.scan_dir)
            self._send(200, "text/html; charset=utf-8", render_all_html(data).encode("utf-8"))
        elif path == "/data.json":
            data = build_all_serve_data(self.scan_dir)
            self._send(200, "application/json; charset=utf-8", json.dumps(data, ensure_ascii=False).encode("utf-8"))
        elif path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
        else:
            body = f"未找到：{path}".encode("utf-8")
            self._send(404, "text/plain; charset=utf-8", body, message="Not Found")


def cmd_all_serve(args):
    if args.scan:
        parent = Path(args.scan).expanduser().resolve()
        if not parent.is_dir():
            die(f"❌ --scan 目录不存在：{parent}")
    handler = type("AllHandler", (AllBoardRequestHandler,), {"scan_dir": args.scan})
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    except OSError as e:
        die(f"❌ 无法监听 127.0.0.1:{args.port}（{e}）——换个 --port 试试")
    url = f"http://127.0.0.1:{args.port}/"
    print(f"eo-board 多项目聚合只读服务已启动：{url}（Ctrl+C 停止）")
    if not args.no_open:
        threading.Timer(0.3, safe_open, args=(url,)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n已停止。")
        server.shutdown()
    return 0


def resolve_project_token(token):
    """--project <路径|注册名> → 项目路径。目录存在按路径；否则查注册名，多命中报歧义不静默取首项。"""
    p = Path(token).expanduser()
    if p.is_dir():
        return p.resolve()
    try:
        reg = load_registry()
    except ConfigError as e:
        die(f"❌ {e}")
    hits = find_by_name(reg, token)
    if len(hits) > 1:
        lines = "\n".join(f"  - {h.get('path')}" for h in hits)
        die(f"❌ 注册名 {token} 命中多个项目，请改用路径：\n{lines}")
    if len(hits) == 1:
        hit_path = entry_path(hits[0])
        if hit_path is None:
            die(f"❌ 注册名 {token} 对应条目非法（path 缺失或不是字符串），请修复注册表或改用路径")
        return Path(hit_path)
    die(f"❌ --project {token} 既不是存在的目录，也不是注册名（eo-board --all 查看已注册项目）")


# ============================================================
# 注册表维护（唯一的写路径例外：写的是用户级 ~/.eo 注册表，不是项目文件）
# ============================================================

def cmd_register(path_str):
    start = Path(path_str).expanduser().resolve()
    cfg_path = find_project_config(start)
    if cfg_path is None:
        die(f"❌ 未找到 .eo-project.json（自 {start} 向上）——先运行 /eo-project-init 初始化项目。")
    try:
        cfg = load_project_config(cfg_path)
        result = register_project(cfg_path.parent, cfg["project_name"])
    except ConfigError as e:
        die(f"❌ {e}")
    entry = result["entry"]
    verb = "已注册" if result["action"] == "created" else "已更新注册（同一仓库，幂等）"
    print(f"✓ {verb}：{entry['name']} → {entry['path']}")
    if result["same_name"]:
        paths = "、".join(str(e.get("path")) for e in result["same_name"])
        print(f"⚠ 注册名 {entry['name']} 同名共存：{paths}——--project 按名解析遇歧义时请改用路径")
    return 0


def cmd_unregister(path_str):
    target = Path(path_str).expanduser().resolve()
    try:
        removed = unregister_project(target)
    except ConfigError as e:
        die(f"❌ {e}")
    if removed is None:
        die(f"未命中任何注册条目：{target}（用 eo-board --all 查看当前注册项目）")
    print(f"✓ 已移除注册：{removed.get('name')} → {removed.get('path')}")
    return 0


