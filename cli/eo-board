def embed_json(data):
    raw = json.dumps(data, ensure_ascii=False)
    return raw.replace("</", "<\\/")  # 防止内容里出现 </script 提前收口标签；\/ 是合法 JSON 转义


def escape_html_text(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


