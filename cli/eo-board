PXX_HEADING_TMPL = r"^#{{3,4}}\s*\[{prefix}-[^\]]+\]\s*(.+?)\s*$"  # 编号后缀不限数字：实测有 P2-S1 / P1-D1 这类字母后缀
CHANGE_REVIEW_ROUND_RE = re.compile(
    r"^##\s*复审记录\s*[（(]第\s*(\d+)\s*轮\s*[·・]\s*(增量|全量)\s*[·・]\s*([\d-]+)[）)]",
    re.MULTILINE,
)
ACCEPTANCE_CHECK_RE = re.compile(r"^-\s*\[([ xX])\]\s*通过")


def file_last_touch(worktree_path, rel_path):
    out = run_git(["log", "--all", "-1", "--format=%cI", "--", rel_path], cwd=worktree_path).strip()
    if out:
        return out[:10]
    full = Path(worktree_path) / rel_path
    if full.is_file():
        return datetime.fromtimestamp(full.stat().st_mtime).strftime("%Y-%m-%d")
    return None


def split_by_h2(text):
    """按任意 `## ` 标题切分（区别于 change.md 的按数字编号切分），用于报告类文件。"""
    sections, cur_title, cur_lines = [], None, []
    for line in text.splitlines():
        if line.startswith("## "):
            sections.append((cur_title, cur_lines))
            cur_title, cur_lines = line[3:].strip(), []
        else:
            cur_lines.append(line)
    sections.append((cur_title, cur_lines))
    return sections


def parse_pxx_headings(text, prefix):
    pat = re.compile(PXX_HEADING_TMPL.format(prefix=re.escape(prefix)), re.MULTILINE)
    return [m.group(1).strip() for m in pat.finditer(text)]


def parse_speed_report(text):
    """定位末节标题含"速报"的节，抓「结论：」「下一步：」两行；解析不出返回 (None, None)——
    容错优先，宁可不给结论也不误判卡点。"""
    lines = text.splitlines()
    start = None
    for i, line in enumerate(lines):
        if re.match(r"^##\s*.*速报", line.strip()):
            start = i
    if start is None:
        return None, None
    verdict, next_step = None, None
    for line in lines[start + 1:]:
        s = line.strip()
        m = re.match(r"^结论[:：]\s*(.+)$", s)
        if m:
            verdict = m.group(1).strip()
            continue
        m = re.match(r"^下一步[:：]\s*(.+)$", s)
        if m:
            next_step = m.group(1).strip()
    return verdict, next_step


def estimate_rounds_approx(fm, worktree_path, rel_path):
    """review.md/test.md 没有显式轮次字段，只能估算：commit 数（未提交存在时至少 1）
    与 frontmatter updated>created 信号（成立则至少 2），取两者较大值。"""
    out = run_git(["log", "--all", "--oneline", "--", rel_path], cwd=worktree_path)
    commit_n = len([l for l in out.splitlines() if l.strip()])
    git_based = commit_n if commit_n > 0 else 1
    created, updated = fm.get("created"), fm.get("updated")
    fm_based = 2 if (created and updated and str(updated) > str(created)) else 1
    return max(git_based, fm_based)


# 复审核销前同属未决：open（未修）+ fixed（已修待 verified）；verified/waived/superseded 不算当前
_LEDGER_UNRESOLVED_STATUSES = frozenset({"open", "fixed"})


def parse_finding_ledger_open_items(body):
    """在「...台账」节表格里收集未决行（状态 open/fixed）：{level, id, summary, status}。

    列位置按表头文字定位；找不到表头时退回模板默认（ID0 / 级别1 / 摘要2 / 状态4）。
    """
    target_lines = None
    for title, lines in split_by_h2(body):
        if title and "台账" in title:
            target_lines = lines
            break
    if target_lines is None:
        return []
    table_rows = [l for l in target_lines if l.strip().startswith("|")]
    if not table_rows:
        return []
    header_cells = [c.strip() for c in table_rows[0].strip().strip("|").split("|")]
    id_idx, level_idx, summary_idx, status_idx = 0, 1, 2, 4
    for idx, cell in enumerate(header_cells):
        if cell in ("ID", "id") or cell.upper() == "ID":
            id_idx = idx
        if "级别" in cell:
            level_idx = idx
        if "摘要" in cell:
            summary_idx = idx
        if "状态" in cell:
            status_idx = idx
    need = max(id_idx, level_idx, summary_idx, status_idx)
    items = []
    for row in table_rows[1:]:
        stripped = row.strip().strip("|")
        if re.fullmatch(r"[\s:|-]+", stripped):
            continue
        cells = [c.strip() for c in stripped.split("|")]
        if len(cells) <= need:
            continue
        st = cells[status_idx].lower()
        if st not in _LEDGER_UNRESOLVED_STATUSES:
            continue
        level = cells[level_idx].upper()
        items.append({
            "level": level,
            "id": cells[id_idx],
            "summary": cells[summary_idx],
            "status": st,
        })
    return items


def parse_finding_ledger_open_p0(body):
    """兼容旧调用：未决（open/fixed）且级别=P0 的行数。"""
    return sum(1 for it in parse_finding_ledger_open_items(body) if it.get("level") == "P0")


def parse_review_gate(path, worktree_path, rel_path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"review.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    fm, body = split_frontmatter(text)
    fm = fm or {}
    p0_titles = parse_pxx_headings(body, "P0")
    p1_titles = parse_pxx_headings(body, "P1")
    p2_titles = parse_pxx_headings(body, "P2")
    verdict, next_step = parse_speed_report(body)
    open_items = parse_finding_ledger_open_items(body)
    open_p0_titles = [
        (f"{it['id']} {it['summary']}".strip() if it.get("id") else it.get("summary") or "")
        for it in open_items if it.get("level") == "P0"
    ]
    open_p1_titles = [
        (f"{it['id']} {it['summary']}".strip() if it.get("id") else it.get("summary") or "")
        for it in open_items if it.get("level") == "P1"
    ]
    open_p0 = sum(1 for it in open_items if it.get("level") == "P0")
    open_p1 = sum(1 for it in open_items if it.get("level") == "P1")
    return {
        "exists": True,
        "rounds_approx": estimate_rounds_approx(fm, worktree_path, rel_path),
        "verdict": verdict,
        "next": next_step,
        "p0": len(p0_titles),
        "p1": len(p1_titles),
        "p2": len(p2_titles),
        "p0_titles": p0_titles[:3],
        "open_p0": open_p0,
        "open_p1": open_p1,
        "open_p0_titles": open_p0_titles[:8],
        "open_p1_titles": open_p1_titles[:8],
        "date": fm.get("updated") or fm.get("created"),
    }


def parse_test_gate(path, worktree_path, rel_path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"test.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    fm, body = split_frontmatter(text)
    fm = fm or {}
    fail_titles = parse_pxx_headings(body, "FAIL")
    verdict, next_step = parse_speed_report(body)
    # 完全通过时历史 FAIL 不算当前未决（「有保留通过」对 test 不适用，仍按含「通过」且无「不通过」）
    passed = bool(
        verdict
        and "通过" in verdict
        and "不通过" not in verdict
        and "有保留通过" not in verdict
    )
    return {
        "exists": True,
        "rounds_approx": estimate_rounds_approx(fm, worktree_path, rel_path),
        "verdict": verdict,
        "next": next_step,
        "fail_count": 0 if passed else len(fail_titles),
        "fail_titles": [] if passed else fail_titles[:8],
        "date": fm.get("updated") or fm.get("created"),
    }


def parse_change_review_gate(path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"change-review.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    fm, body = split_frontmatter(text)
    fm = fm or {}

    round_matches = list(CHANGE_REVIEW_ROUND_RE.finditer(body))
    rounds = 1 + len(round_matches)
    if round_matches:
        last = round_matches[-1]
        mode, round_date = last.group(2), last.group(3)
    else:
        mode, round_date = "全量", None  # 首轮无复审记录节，必为全量

    verdict, next_step = parse_speed_report(body)
    open_items = parse_finding_ledger_open_items(body)
    open_p0_titles = [
        (f"{it['id']} {it['summary']}".strip() if it.get("id") else it.get("summary") or "")
        for it in open_items if it.get("level") == "P0"
    ]
    return {
        "exists": True,
        "rounds": rounds,
        "mode": mode,
        "open_p0": sum(1 for it in open_items if it.get("level") == "P0"),
        "open_p0_titles": open_p0_titles[:8],
        "verdict": verdict,
        "next": next_step,
        "date": round_date or fm.get("created"),
    }


def parse_acceptance_gate(path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"acceptance.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    total = unchecked = 0
    for line in text.splitlines():
        m = ACCEPTANCE_CHECK_RE.match(line.strip())
        if m:
            total += 1
            if m.group(1) == " ":
                unchecked += 1
    return {"exists": True, "total": total, "unchecked": unchecked}


def compute_gates(rec, doc_root, warnings):
    """汇总四类质量门文件，并合成单一 blocker：候选按 gate 文件末次触碰时间取最新一条。"""
    wt_path = rec["worktree"]
    rel_dir = f"{doc_root}/changes/{rec['dirname']}"
    dir_path = Path(wt_path) / rel_dir
    gates = {}
    candidates = []  # (touch_date, blocker_text)

    cr_path = dir_path / "change-review.md"
    if cr_path.is_file():
        g = parse_change_review_gate(cr_path, warnings)
        gates["change_review"] = g
        if g.get("open_p0"):
            text = f"change-review 第{g['rounds']}轮 · P0×{g['open_p0']} 未决"
            if g["rounds"] >= 3:
                text += "（已到轮限，待用户裁决）"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/change-review.md") or "", text))

    review_path = dir_path / "review.md"
    if review_path.is_file():
        g = parse_review_gate(review_path, wt_path, f"{rel_dir}/review.md", warnings)
        gates["review"] = g
        open_p0 = int(g.get("open_p0") or 0)
        open_p1 = int(g.get("open_p1") or 0)
        if g.get("verdict") and "不通过" in g["verdict"]:
            text = f"review P0×{g.get('p0', 0)} 待修"
            if g.get("rounds_approx", 1) >= 2:
                text += f"（第≈{g['rounds_approx']}轮）"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/review.md") or "", text))
        elif open_p0 or open_p1:
            # 有保留通过等：台账 open/fixed 仍为当前卡点
            bits = []
            if open_p0:
                bits.append(f"P0×{open_p0}")
            if open_p1:
                bits.append(f"P1×{open_p1}")
            text = "review 未决 · " + " ".join(bits)
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/review.md") or "", text))

    test_path = dir_path / "test.md"
    if test_path.is_file():
        g = parse_test_gate(test_path, wt_path, f"{rel_dir}/test.md", warnings)
        gates["test"] = g
        if g.get("verdict") and "不通过" in g["verdict"]:
            text = f"test 不通过 · FAIL×{g.get('fail_count', 0)}"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/test.md") or "", text))

    acc_path = dir_path / "acceptance.md"
    if acc_path.is_file():
        g = parse_acceptance_gate(acc_path, warnings)
        gates["acceptance"] = g
        if rec["status"] in ("reviewed", "implementing") and g.get("unchecked"):
            text = f"人工验收 {g['unchecked']} 项待勾"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/acceptance.md") or "", text))

    rec["gates"] = gates
    rec["blocker"] = max(candidates, key=lambda c: c[0])[1] if candidates else None


JOURNAL_ENTRY_RE = re.compile(r"^•\s+\d{1,2}:\d{2}\b", re.MULTILINE)
JOURNAL_RECENT_LIMIT = 5
STAGE_WARN_ROUNDS = 3


def parse_journal_entries(text, limit=JOURNAL_RECENT_LIMIT):
    """把 journal.md 切成窗口报告列表（最近 limit 条）。解析失败时降级为原文尾部一条。"""
    if not text or not str(text).strip():
        return []
    body = str(text)
    matches = list(JOURNAL_ENTRY_RE.finditer(body))
    if not matches:
        tail_lines = body.strip().splitlines()[-40:]
        tail = "\n".join(tail_lines).strip()
        if not tail:
            return []
        return [{"title": "（未解析到窗口标题）", "body": tail, "raw": tail}]
    entries = []
    for i, m in enumerate(matches):
        start = m.start()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(body)
        block = body[start:end].strip()
        lines = block.splitlines()
        title = lines[0].lstrip("•").strip() if lines else ""
        entry_body = "\n".join(lines[1:]).strip()
        entries.append({"title": title, "body": entry_body, "raw": block})
    if limit and limit > 0:
        entries = entries[-limit:]
    # 时间逆序：最新窗口报告在最上
    return list(reversed(entries))


def _gate_verdict_pass(g):
    """完全通过：含「通过」且不含「不通过」/「有保留通过」。"""
    v = (g or {}).get("verdict") or ""
    if not v or "不通过" in v or "有保留通过" in v:
        return False
    return "通过" in v


def _gate_verdict_fail(g):
    v = (g or {}).get("verdict") or ""
    return "不通过" in v


def _max_gate_rounds(gates):
    max_rounds = 0
    for key, field in (
        ("change_review", "rounds"),
        ("test", "rounds_approx"),
        ("review", "rounds_approx"),
    ):
        g = gates.get(key) or {}
        r = g.get(field)
        if isinstance(r, int) and r > max_rounds:
            max_rounds = r
    return max_rounds


def _review_open_p0(rv):
    """未决 P0：优先台账 open/fixed 计数；完全通过时强制 0。"""
    if not rv:
        return 0
    if _gate_verdict_pass(rv):
        return 0
    if "open_p0" in rv and rv.get("open_p0") is not None:
        return int(rv.get("open_p0") or 0)
    if _gate_verdict_fail(rv):
        return int(rv.get("p0") or 0)
    return 0


def _review_open_p1(rv):
    """未决 P1：台账 open/fixed；完全通过时强制 0。"""
    if not rv or _gate_verdict_pass(rv):
        return 0
    if "open_p1" in rv and rv.get("open_p1") is not None:
        return int(rv.get("open_p1") or 0)
    titles = rv.get("open_p1_titles") or []
    return len(titles)


def derive_stage_progress(gates, status=None):
    """从 gates + status 推导卡面阶段徽标 + 轮次警告。

    阶段标签只展示仍未决的门（速报不通过 / 台账 open / FAIL 未过），不把已通过的
    历史报告或历史 P0 当成当前状态。acceptance 仅在 status=reviewed 时覆盖。

    警告与阶段解耦：任一门 max rounds ≥ STAGE_WARN_ROUNDS 时始终 warn=True，
    即使 stage/label 为空（已通过/archived、无当前门），卡片仍可挂 card-warn。
    """
    gates = gates or {}
    status = (status or "").strip()
    max_rounds = _max_gate_rounds(gates)
    warn = max_rounds >= STAGE_WARN_ROUNDS

    def _warn_only():
        if not warn:
            return None
        return {"stage": None, "label": None, "rounds": max_rounds, "warn": True}

    # archived：不贴当前阶段，但保留历史高轮次警告
    if status == "archived":
        return _warn_only()

    cr = gates.get("change_review") or None
    ts = gates.get("test") or None
    rv = gates.get("review") or None
    acc = gates.get("acceptance") or None

    cr_open = int((cr or {}).get("open_p0") or 0) if cr else 0
    rv_open_p0 = _review_open_p0(rv)
    rv_open_p1 = _review_open_p1(rv)

    cr_active = bool(cr) and (cr_open > 0 or _gate_verdict_fail(cr))
    ts_active = bool(ts) and (
        _gate_verdict_fail(ts)
        or (not _gate_verdict_pass(ts) and int((ts or {}).get("fail_count") or 0) > 0)
    )
    # 不通过 / 台账未决 P0|P1（含有保留通过 + open/fixed）均算当前 review 阶段
    rv_active = bool(rv) and (
        _gate_verdict_fail(rv) or rv_open_p0 > 0 or rv_open_p1 > 0
    )
    # 人工验收只在流程真正进入 reviewed 后才抢占徽标
    acc_active = bool(acc) and bool(acc.get("unchecked")) and status == "reviewed"

    stage = label = None
    rounds = 0

    # 未决阻塞优先：后段门 > 前段门；验收仅 reviewed
    if rv_active:
        stage = "review"
        rounds = int(rv.get("rounds_approx") or 1)
        parts = []
        if rv_open_p0 > 0:
            parts.append(f"P0×{rv_open_p0}")
        if rv_open_p1 > 0:
            parts.append(f"P1×{rv_open_p1}")
        if parts:
            label = "review " + " ".join(parts)
        else:
            label = f"review ≈{rounds} 轮"
    elif ts_active:
        stage = "test"
        rounds = int(ts.get("rounds_approx") or 1)
        label = f"test ≈{rounds} 轮"
        fails = int(ts.get("fail_count") or 0)
        if fails:
            label += f" FAIL×{fails}"
    elif cr_active:
        stage = "change_review"
        rounds = int(cr.get("rounds") or 1)
        label = f"change-review 第{rounds}轮"
        if cr_open:
            label += f" P0×{cr_open}"
    elif acc_active:
        stage = "acceptance"
        total = acc.get("total") or 0
        done = total - (acc.get("unchecked") or 0)
        rounds = max_rounds
        label = f"验收 {done}/{total}"
    else:
        # 无明确阻塞：按 status 给「进行中」门（速报已通过的不展示）
        if status == "implementing":
            if rv and not _gate_verdict_pass(rv) and not _gate_verdict_fail(rv):
                stage, rounds = "review", int(rv.get("rounds_approx") or 1)
                label = f"review ≈{rounds} 轮"
            elif ts and not _gate_verdict_pass(ts) and not _gate_verdict_fail(ts):
                stage, rounds = "test", int(ts.get("rounds_approx") or 1)
                label = f"test ≈{rounds} 轮"
            elif cr and not _gate_verdict_pass(cr) and not _gate_verdict_fail(cr):
                stage, rounds = "change_review", int(cr.get("rounds") or 1)
                label = f"change-review 第{rounds}轮"
        elif status in ("draft", "confirmed") and cr and not _gate_verdict_pass(cr):
            stage, rounds = "change_review", int(cr.get("rounds") or 1)
            label = f"change-review 第{rounds}轮"
            if cr_open:
                label += f" P0×{cr_open}"
        elif status == "reviewed" and acc and acc.get("unchecked"):
            stage = "acceptance"
            total = acc.get("total") or 0
            done = total - (acc.get("unchecked") or 0)
            rounds = max_rounds
            label = f"验收 {done}/{total}"

    if stage is None:
        return _warn_only()
    return {
        "stage": stage,
        "label": label,
        "rounds": rounds if stage != "acceptance" else max_rounds,
        "warn": warn,
    }


def _frontmatter_public(fm):
    """概览用 frontmatter：缺省/空值不输出，保留 YAML 解析后的键顺序。"""
    if not fm:
        return {}
    out = {}
    for key, value in fm.items():
        if value is None or value == "":
            continue
        out[str(key)] = value
    return out


def attach_card_progress(rec, warnings):
    """给 change 记录补 full_text / journal / stage_progress / frontmatter（只读、失败降级）。"""
    path = Path(rec["path"])
    try:
        rec["full_text"] = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"change 全文读取失败：{path}（{e}）")
        rec["full_text"] = None

    rec["frontmatter"] = {}
    if rec.get("full_text"):
        try:
            fm, _ = split_frontmatter(rec["full_text"])
            rec["frontmatter"] = _frontmatter_public(fm)
        except Exception as e:
            warnings.append(f"frontmatter 再解析失败：{path}（{e}）")
            rec["frontmatter"] = {}

    jpath = Path(rec["worktree"]) / "tmp" / "eo" / "loop" / rec["id"] / "journal.md"
    if jpath.is_file():
        rec["has_journal"] = True
        try:
            jtext = jpath.read_text(encoding="utf-8")
            rec["journal_entries"] = parse_journal_entries(jtext)
            rec["journal_path"] = str(jpath)
        except Exception as e:
            warnings.append(f"journal 读取失败：{jpath}（{e}）")
            rec["journal_entries"] = []
            rec["journal_path"] = str(jpath)
    else:
        rec["has_journal"] = False
        rec["journal_entries"] = None
        rec["journal_path"] = None

    rec["stage_progress"] = derive_stage_progress(rec.get("gates"), rec.get("status"))


def compute_monthly_direct_commits(anchor_dir):
    since = date.today().replace(day=1).isoformat()
    out = run_git(["log", "--all", "--pretty=%s", "--since", since], cwd=str(anchor_dir))
    fix_n = sum(1 for s in out.splitlines() if s.startswith("fix:"))
    ui_n = sum(1 for s in out.splitlines() if s.startswith("ui:"))
    return {"fix": fix_n, "ui": ui_n, "total": fix_n + ui_n, "since": since}


