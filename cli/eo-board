// 块级：标题 #~#### / 表格 / fenced code / 列表(含 checkbox) / 引用 / hr / 段落。
// 全文先 esc() 一次再按行做结构识别——零第三方，只认白名单结构。
function mdBlock(raw) {
  if (!raw) return '';
  var lines = esc(raw).split('\n');
  var html = '';
  var i = 0;
  while (i < lines.length) {
    var line = lines[i];
    var trimmed = line.trim();
    if (!trimmed) { i++; continue; }

    // fenced code
    if (/^```/.test(trimmed)) {
      i++;
      var code = [];
      while (i < lines.length && !/^```/.test(lines[i].trim())) {
        code.push(lines[i]);
        i++;
      }
      if (i < lines.length) i++;
      html += '<pre class="md-code"><code>' + code.join('\n') + '</code></pre>';
      continue;
    }
    // horizontal rule
    if (/^(-{3,}|\*{3,}|_{3,})\s*$/.test(trimmed)) {
      html += '<hr>';
      i++;
      continue;
    }
    // ATX headings # .. ####
    var mHeading = trimmed.match(/^(#{1,4})\s+(.*)$/);
    if (mHeading) {
      var lv = mHeading[1].length;
      html += '<h' + lv + '>' + applyInline(mHeading[2]) + '</h' + lv + '>';
      i++;
      continue;
    }
    // table: header + separator
    if (trimmed.indexOf('|') !== -1 && i + 1 < lines.length && mdIsTableSep(lines[i + 1].trim())) {
      var heads = mdSplitRow(trimmed);
      i += 2;
      var bodyRows = [];
      while (i < lines.length && lines[i].trim() && lines[i].trim().indexOf('|') !== -1
             && !mdIsTableSep(lines[i].trim())) {
        bodyRows.push(mdSplitRow(lines[i].trim()));
        i++;
      }
      html += '<table class="md-table"><thead><tr>'
        + heads.map(function (c) { return '<th>' + applyInline(c) + '</th>'; }).join('')
        + '</tr></thead><tbody>'
        + bodyRows.map(function (row) {
          return '<tr>' + heads.map(function (_, idx) {
            return '<td>' + applyInline(row[idx] || '') + '</td>';
          }).join('') + '</tr>';
        }).join('')
        + '</tbody></table>';
      continue;
    }
    if (/^&gt;\s?/.test(trimmed)) {
      var quoteLines = [];
      while (i < lines.length && /^&gt;\s?/.test(lines[i].trim())) {
        quoteLines.push(applyInline(lines[i].trim().replace(/^&gt;\s?/, '')));
        i++;
      }
      html += '<blockquote>' + quoteLines.join('<br>') + '</blockquote>';
      continue;
    }
    if (/^(\s*)([-*+]|\d+\.)\s+/.test(line) || /^(\s*)[-*+]\s+\[[ xX]\]\s+/.test(line)) {
      var listResult = mdList(lines, i);
      html += listResult.html;
      i = listResult.next;
      continue;
    }
    var paraLines = [];
    while (i < lines.length && lines[i].trim()
           && !/^(#{1,4})\s+/.test(lines[i].trim())
           && !/^&gt;\s?/.test(lines[i].trim())
           && !/^```/.test(lines[i].trim())
           && !/^(-{3,}|\*{3,}|_{3,})\s*$/.test(lines[i].trim())
           && !/^(\s*)([-*+]|\d+\.)\s+/.test(lines[i])
           && !/^(\s*)[-*+]\s+\[[ xX]\]\s+/.test(lines[i])
           && !(lines[i].trim().indexOf('|') !== -1 && i + 1 < lines.length && mdIsTableSep(lines[i + 1].trim()))) {
      paraLines.push(applyInline(lines[i].trim()));
      i++;
    }
    if (paraLines.length) html += '<p>' + paraLines.join('<br>') + '</p>';
  }
  return html;
}

function stPill(status) {
  var st = STATUS[status] || { zh: status, cssVar: '--st-draft' };
  return '<span class="st-pill" style="background: var(' + st.cssVar + '-soft); color: var(' + st.cssVar + ')">'
    + esc(status) + ' · ' + esc(st.zh) + '</span>';
}

function metaRow(dt, dd) { return '<dt>' + dt + '</dt><dd>' + dd + '</dd>'; }

function formatFmValue(v) {
  if (v === null || v === undefined) return null;
  if (Array.isArray(v)) return v.length ? v.map(function (x) { return String(x); }).join(', ') : null;
  if (typeof v === 'object') {
    try { return JSON.stringify(v); } catch (e) { return String(v); }
  }
  var s = String(v);
  return s === '' ? null : s;
}

function renderFrontmatter(d) {
  var fm = d.frontmatter;
  if (!fm || typeof fm !== 'object') return '';
  var keys = Object.keys(fm);
  if (!keys.length) return '';
  var rows = '';
  keys.forEach(function (k) {
    var v = formatFmValue(fm[k]);
    if (v === null) return;
    rows += metaRow(esc(k), esc(v));
  });
  if (!rows) return '';
  return '<div class="d-section"><div class="d-label">frontmatter <span class="src">change.md YAML</span></div>'
    + '<dl class="meta-grid fm-grid">' + rows + '</dl></div>';
}

function ckItem(it) {
  var noteCls = it.manual ? 'vnote manual' : 'vnote';
  var html = '<li><span class="ck' + (it.done ? ' done' : '') + '"></span>';
  if (it.code) html += '<span class="ck-code">' + esc(it.code) + '</span>';
  html += '<span class="ck-text">' + mdInline(it.text);
  if (it.note) html += '<span class="' + noteCls + '">' + esc(it.note) + '</span>';
  if (it.file) {
    html += '<span class="vnote"><code>' + esc(it.file) + '</code>'
      + (it.ac ? ' · 对应 ' + esc(it.ac) : '')
      + (it.criteria ? '（完成判据：' + esc(it.criteria) + '）' : '') + '</span>';
  }
  html += '</span></li>';
  return html;
}

function gateRow(label, roundsText, g, detailTitles) {
  var html = '<div class="gate-row"><div class="gate-head"><span class="gate-name">' + esc(label) + '</span>';
  if (roundsText) html += '<span class="gate-rounds">' + esc(roundsText) + '</span>';
  html += '</div>';
  if (g.verdict || g.next) {
    if (g.verdict) html += '<div class="gate-line">结论：' + mdInline(g.verdict) + '</div>';
    if (g.next) html += '<div class="gate-line gate-next">下一步：' + mdInline(g.next) + '</div>';
  } else {
    html += '<div class="gate-line" style="color: var(--faint)">速报未解析到（文件可能偏离模板），仅确认文件存在</div>';
  }
  if (detailTitles && detailTitles.length) {
    html += '<ul class="gate-titles">' + detailTitles.map(function (t) {
      return '<li><code>' + mdInline(t) + '</code></li>';
    }).join('') + '</ul>';
  }
  html += '</div>';
  return html;
}

function gateVerdictPass(g) {
  // 完全通过：不含「不通过」「有保留通过」
  var v = (g && g.verdict) || '';
  if (!v || v.indexOf('不通过') !== -1 || v.indexOf('有保留通过') !== -1) return false;
  return v.indexOf('通过') !== -1;
}

function gateVerdictFail(g) {
  var v = (g && g.verdict) || '';
  return v.indexOf('不通过') !== -1;
}

/** 质量门 tab 顶部：当前阶段 / 卡点 / 未决明细（与卡面 stage_progress、blocker 同源） */
function renderCurrentGateStatus(d) {
  var sp = d.stage_progress;
  var g = d.gates || {};
  var h = '<div class="d-section current-gate-status"><div class="d-label">当前状态 <span class="src">stage_progress · blocker · 未决台账</span></div>';
  h += '<dl class="meta-grid">';
  if (sp && sp.label) {
    h += metaRow('阶段', esc(sp.label) + (sp.warn ? ' <span class="tag warn">轮次≥3</span>' : ''));
  } else if (sp && sp.warn) {
    h += metaRow('阶段', '<span style="color:var(--faint)">无活动阶段</span> <span class="tag warn">历史轮次≥3</span>');
  } else {
    h += metaRow('阶段', '<span style="color:var(--faint)">无活动质量门阶段</span>');
  }
  if (d.blocker) {
    h += metaRow('卡点', '<span style="color:var(--warn);font-weight:600">⛔ ' + esc(d.blocker) + '</span>');
  } else {
    h += metaRow('卡点', '<span style="color:var(--st-reviewed)">当前无卡点</span>');
  }
  h += '</dl>';

  var openItems = [];
  var cr = g.change_review;
  if (cr && cr.open_p0) {
    var crTitles = cr.open_p0_titles || [];
    if (crTitles.length) {
      crTitles.forEach(function (t) { openItems.push({ gate: 'change-review', level: 'P0', text: t }); });
    } else {
      openItems.push({ gate: 'change-review', level: 'P0', text: 'open P0×' + cr.open_p0 });
    }
  }
  var rv = g.review;
  if (rv && !gateVerdictPass(rv)) {
    (rv.open_p0_titles || []).forEach(function (t) {
      openItems.push({ gate: 'review', level: 'P0', text: t });
    });
    (rv.open_p1_titles || []).forEach(function (t) {
      openItems.push({ gate: 'review', level: 'P1', text: t });
    });
    // 无台账 open 标题但速报不通过时，不回退到历史 p0_titles（P1-1 当前性）
  }
  var ts = g.test;
  if (ts && (gateVerdictFail(ts) || (ts.fail_count && !gateVerdictPass(ts)))) {
    (ts.fail_titles || []).forEach(function (t) {
      openItems.push({ gate: 'test', level: 'FAIL', text: t });
    });
  }
  var acc = g.acceptance;
  if (acc && acc.unchecked && d.status === 'reviewed') {
    openItems.push({ gate: 'acceptance', level: '验收', text: '待勾 ' + acc.unchecked + '/' + acc.total });
  }

  if (openItems.length) {
    h += '<div class="gate-line" style="margin-top:8px;font-weight:600">未决明细</div><ul class="gate-open-list">';
    openItems.forEach(function (it) {
      h += '<li><span class="gate-open-tag">' + esc(it.gate) + '</span> '
        + '<span class="gate-open-level">' + esc(it.level) + '</span> '
        + mdInline(it.text) + '</li>';
    });
    h += '</ul>';
  } else if (!d.blocker) {
    h += '<div class="empty-hint" style="margin-top:8px">当前无卡点</div>';
  }
  h += '</div>';
  return h;
}

function renderGates(d) {
  var g = d.gates;
  if (!g || !(g.change_review || g.review || g.test || g.acceptance)) {
    // 无门文件时仍可能展示 stage/blocker 空态
    return renderCurrentGateStatus(d);
  }
  var h = renderCurrentGateStatus(d);
  h += '<div class="d-section"><div class="d-label">各门报告</div><div class="gates">';
  if (g.change_review) {
    var cr = g.change_review;
    h += gateRow('change-review', '第 ' + cr.rounds + ' 轮 · ' + esc(cr.mode || '?')
      + (cr.open_p0 ? (' · open P0×' + cr.open_p0) : ''), cr,
      (cr.open_p0 && cr.open_p0_titles) ? cr.open_p0_titles : null);
  }
  if (g.review) {
    var rv = g.review;
    // 各门报告区：仅挂当前 open 标题，不挂历史 p0_titles
    var rvOpen = [].concat(rv.open_p0_titles || [], rv.open_p1_titles || []);
    h += gateRow('review', '≈' + rv.rounds_approx + ' 轮 · P0×' + rv.p0 + ' P1×' + rv.p1 + ' P2×' + rv.p2,
      rv, gateVerdictPass(rv) ? null : (rvOpen.length ? rvOpen : null));
  }
  if (g.test) {
    var ts = g.test;
    h += gateRow('test', '≈' + ts.rounds_approx + ' 轮 · FAIL×' + ts.fail_count, ts,
      (ts.fail_titles && ts.fail_titles.length) ? ts.fail_titles : null);
  }
  if (g.acceptance) {
    var a = g.acceptance;
    h += '<div class="gate-row"><div class="gate-head"><span class="gate-name">人工验收</span>'
      + '<span class="gate-rounds">' + (a.total - a.unchecked) + '/' + a.total + ' 已勾</span></div>'
      + (a.unchecked
        ? '<div class="gate-line">待勾 ' + a.unchecked + ' 项</div>'
        : '<div class="gate-line" style="color: var(--st-reviewed)">全部已勾</div>')
      + '</div>';
  }
  h += '</div></div>';
  return h;
}

function renderJournal(d) {
  if (!d.has_journal) {
    return '<div class="empty-hint">暂无 loop 窗口报告——仅被 eo-loop 跑过的 change 会有 journal'
      + '（路径 tmp/eo/loop/&lt;slug&gt;/journal.md）</div>';
  }
  var entries = d.journal_entries || [];
  if (!entries.length) {
    return '<div class="empty-hint">journal 文件存在但未解析到窗口条目</div>';
  }
  var h = '<div class="journal-list">';
  entries.forEach(function (e) {
    var bodyRaw = e.body || e.raw || '';
    h += '<article class="journal-entry"><div class="j-title">' + esc(e.title || '（无标题）') + '</div>'
      + '<div class="j-body md-block">' + (bodyRaw ? mdBlock(bodyRaw) : '') + '</div></article>';
  });
  h += '</div>';
  if (d.journal_path) {
    h += '<div class="path-box" style="margin-top:10px">' + esc(d.journal_path) + '</div>'
      + '<div class="path-hint">journal 为 tmp 速报，可丢弃、不作信源</div>';
  }
  return h;
}

function renderChange(d) {
  var tabs = [
    ['overview', '概览'],
    ['checklist', '清单'],
    ['gates', '质量门'],
    ['journal', '动态'],
    ['full', '全文']
  ];
  var h = '<div class="detail-tabs" role="tablist">';
  tabs.forEach(function (t, i) {
    h += '<button type="button" class="detail-tab' + (i === 0 ? ' active' : '') + '" role="tab" data-tab="'
      + t[0] + '"' + (i === 0 ? ' aria-selected="true"' : '') + '>' + t[1] + '</button>';
  });
  h += '</div>';

  var showBranch = d.branch && (d.diverged || !d.is_default_worktree);
  var meta = metaRow('created', esc(d.created || '-'))
    + metaRow('最近活动', esc(d.last_touch || '-') + ' <span class="src">git 推导</span>')
    + metaRow('worktree', esc(d.worktree_name || '-'));
  if (showBranch) meta += metaRow('branch', '⎇ ' + esc(d.branch));
  if (d.commit_count) meta += metaRow('commits', d.commit_count + ' 个（[' + esc(d.id) + '] 前缀）');
  if (d.test_lock_commit) meta += metaRow('测试锁定', esc(d.test_lock_commit) + ' <span class="src">frontmatter·test_lock_commit</span>');
  if (d.issue !== null && d.issue !== undefined) meta += metaRow('issue', '#' + esc(d.issue));
  if (d.pr) meta += metaRow('PR', esc(d.pr));
  if (d.stale) meta += metaRow('停滞', '<span style="color: var(--warn); font-weight: 700">' + d.stale_days + ' 天未动（防蒸发提醒）</span>');

  h += '<div class="detail-pane active" data-pane="overview" role="tabpanel">';
  h += renderFrontmatter(d);
  h += '<div class="d-section"><div class="d-label">派生信息 <span class="src">git / 运行时</span></div>'
    + '<dl class="meta-grid">' + meta + '</dl></div>';
  if (d.forks && d.forks.length) {
    var forkRows = d.forks.map(function (f) {
      return '<button type="button" class="fork-row" data-fork="' + esc(f._key) + '">'
        + '<span class="tag branch wt-split"><span class="wt-line">⎇ ' + esc(f.branch || '?') + '</span>'
        + '<span class="wt-line">' + esc(f.worktree_name || '?') + '</span></span>'
        + stPill(f.status)
        + '<span class="fork-when">' + esc(f.last_touch || '-') + '</span>'
        + '</button>';
    }).join('');
    h += '<div class="d-section"><div class="d-label">分叉×' + d.forks.length
      + ' <span class="src">同 id 其余内容变体 · 当前出卡为最近活动最新一份</span></div>'
      + '<div class="fork-list">' + forkRows + '</div></div>';
  }
  h += '<div class="d-section"><div class="d-label">意图 §1 <span class="src">正文解析</span></div>'
    + '<div class="md-block">' + (d.intent ? mdBlock(d.intent) : '<p style="color: var(--faint)">（未解析到意图正文）</p>') + '</div>';
  if (d.decisions && d.decisions.length) {
    h += '<ul class="decisions">' + d.decisions.map(function (dc) {
      return '<li>' + mdInline(dc.text) + (dc.assume ? ' <span class="assume">（假设，未逐条确认）</span>' : '') + '</li>';
    }).join('') + '</ul>';
  }
  h += '</div></div>';

  h += '<div class="detail-pane" data-pane="checklist" role="tabpanel">';
  var acDone = d.ac.filter(function (a) { return a.done; }).length;
  h += '<div class="d-section"><div class="d-label">验收清单 §2 <span class="cnt">' + acDone + '/' + d.ac.length + '</span>'
    + '<span class="src">§2 checkbox 现场计数</span></div>'
    + (d.ac.length ? '<ul class="cklist">' + d.ac.map(ckItem).join('') + '</ul>' : '<div class="empty-hint">未解析到 AC（可能是正文格式不规整）</div>') + '</div>';
  if (d.todo) {
    var all = d.todo.reduce(function (acc, b) { return acc.concat(b.items); }, []);
    var tdDone = all.filter(function (t) { return t.done; }).length;
    h += '<div class="d-section"><div class="d-label">TODO §3 <span class="cnt">' + tdDone + '/' + all.length + '</span>'
      + '<span class="src">§3 checkbox · Batch 分组</span></div>';
    d.todo.forEach(function (b) {
      h += '<div class="batch-name">' + esc(b.batch) + '</div><ul class="cklist">' + b.items.map(ckItem).join('') + '</ul>';
    });
    h += '</div>';
  } else {
    h += '<div class="d-section"><div class="d-label">TODO §3</div>'
      + '<div class="intent-text" style="color: var(--faint); font-size: 12.5px">轻档无 TODO 节（AC 即工作清单）</div></div>';
  }
  h += '</div>';

  h += '<div class="detail-pane" data-pane="gates" role="tabpanel">';
  var gatesHtml = renderGates(d);
  h += gatesHtml || '<div class="empty-hint">尚无质量门报告</div>';
  if (d.oq && d.oq.length) {
    h += '<div class="d-section"><div class="d-label">开放问题 §8</div><ul class="oq-list">'
      + d.oq.map(function (q) { return '<li>' + (q.code ? '<b>' + esc(q.code) + '</b> ' : '') + esc(q.text) + '</li>'; }).join('')
      + '</ul></div>';
  }
  h += '</div>';

  h += '<div class="detail-pane" data-pane="journal" role="tabpanel">'
    + '<div class="d-section"><div class="d-label">动态 <span class="src">tmp/eo/loop journal</span></div>'
    + renderJournal(d) + '</div></div>';

  h += '<div class="detail-pane" data-pane="full" role="tabpanel">'
    + '<div class="d-section"><div class="d-label">全文</div>'
    + '<div class="path-box">' + esc(d.path) + '</div>'
    + (d.full_text
      ? '<div class="full-md md-block">' + mdBlock(d.full_text) + '</div>'
      : '<div class="empty-hint">全文不可用（读取失败）</div>')
    + '</div></div>';
  return h;
}

function renderBacklog(d) {
  var h = '';
  var meta = metaRow('created', esc(d.created || '—'));
  if (d.tags && d.tags.length) meta += metaRow('tags', d.tags.map(esc).join(' · '));
  if (d.issue) meta += metaRow('issue', esc(d.issue) + ' <span class="src">frontmatter·issue（外来）</span>');
  h += '<div class="d-section"><dl class="meta-grid">' + meta + '</dl></div>';
  h += '<div class="d-section"><div class="d-label">正文 <span class="src">卡片全文，源数据可直接手改</span></div>'
    + '<div class="intent-text">' + (d.body ? esc(d.body) : '<span style="color: var(--faint)">（无补充说明）</span>') + '</div></div>';
  h += '<div class="d-section"><div class="d-label">文件</div><div class="path-box">' + esc(d.path) + '</div>'
    + '<div class="path-hint">backlog 卡是源数据不是投影——改 title / tags / 正文直接编辑此文件即可</div></div>';
  return h;
}

function changeCard(d) {
  var acDone = d.ac.filter(function (a) { return a.done; }).length, acTotal = d.ac.length;
  var acPct = acTotal ? Math.round(acDone / acTotal * 100) : 0;
  var todoHtml = '';
  if (d.todo) {
    var all = d.todo.reduce(function (acc, b) { return acc.concat(b.items); }, []);
    var tdDone = all.filter(function (t) { return t.done; }).length, tdTotal = all.length;
    var tdPct = tdTotal ? Math.round(tdDone / tdTotal * 100) : 0;
    var batchDone = d.todo.filter(function (b) { return b.items.length && b.items.every(function (i) { return i.done; }); }).length;
    todoHtml = '<div class="prog-row"><span class="prog-lbl">TODO</span><span class="bar"><i style="width:' + tdPct + '%"></i></span>'
      + '<span class="prog-num">' + tdDone + '/' + tdTotal + ' · B' + batchDone + '/' + d.todo.length + '</span></div>';
  }
  var sp = d.stage_progress;
  var stageHtml = '';
  if (sp && sp.label) {
    stageHtml = '<div class="card-stage-line"><span class="tag ' + (sp.warn ? 'warn' : 'stage') + '">' + esc(sp.label) + '</span></div>';
  }
  var foot = '';
  if ((d.branch || d.worktree_name) && (d.diverged || !d.is_default_worktree))
    foot += '<span class="tag branch wt-split"><span class="wt-line">⎇ ' + esc(d.branch || '?') + '</span><span class="wt-line">' + esc(d.worktree_name || '?') + '</span></span>';
  if (d.forks && d.forks.length)
    foot += '<span class="tag branch" title="同 id 其余内容变体，详情内可切换查看">分叉×' + d.forks.length + '</span>';
  if (d.commit_count) foot += '<span class="tag">' + d.commit_count + ' commits</span>';
  if (d.issue !== null && d.issue !== undefined) foot += '<span class="tag ok">issue #' + esc(d.issue) + '</span>';
  if (d.pr) foot += '<span class="tag ok">PR ↗</span>';
  if (d.test_lock_commit) { var lockCommit = String(d.test_lock_commit); foot += '<span class="tag lock" title="' + esc(lockCommit) + '">测试锁定 ' + esc(lockCommit.slice(0, 8)) + '</span>'; }
  if (d.artifacts && d.artifacts.change_review && d.artifacts.change_review.exists) foot += '<span class="tag">change-review ✓</span>';
  if (d.artifacts && d.artifacts.test && d.artifacts.test.exists) foot += '<span class="tag">test.md ✓</span>';
  if (d.stale) foot += '<span class="tag warn">⚠ ' + d.stale_days + ' 天未动</span>';
  if (d.blocker) foot += '<span class="tag warn">⛔ ' + esc(d.blocker) + '</span>';

  var cardClass = 'card'
    + (d.status === 'archived' ? ' dim' : '')
    + (sp && sp.warn ? ' card-warn' : '');
  return '<article class="' + cardClass + '" data-detail="' + esc(d._key)
    + '" tabindex="0" role="button" aria-label="查看详情：#' + esc(d.seq != null ? d.seq : '?') + ' ' + esc(d.title) + '">'
    + '<div class="card-top"><span class="seq">#' + esc(d.seq != null ? d.seq : '?') + '</span>'
    + '<span class="tier ' + esc(d.tier) + '">' + esc(d.tier) + '</span>'
    + '<span class="type">' + esc(d.type) + '</span><span class="src">frontmatter</span></div>'
    + '<div class="card-title">' + mdInline(d.title) + '</div>'
    + (d.summary ? '<div class="card-summary">' + mdInline(d.summary) + '</div>' : '')
    + '<div class="slug">' + esc(d.dirname || d.id) + '/</div>'
    + '<div class="progress">'
    + '<div class="prog-row" style="--bar-color: var(--st-reviewed)"><span class="prog-lbl">AC</span><span class="bar"><i style="width:' + acPct + '%"></i></span><span class="prog-num">' + acDone + '/' + acTotal + '</span></div>'
    + todoHtml
    + '<span class="src">正文 checkbox 现场计数</span>'
    + '</div>'
    + stageHtml
    + '<div class="card-foot">' + foot + '<span class="date">' + esc(d.last_touch || '') + '</span></div>'
    + '</article>';
}

function backlogCard(d) {
  var tags = (d.tags || []).map(function (t) { return '<span class="tag">' + esc(t) + '</span>'; }).join('');
  return '<article class="card" data-detail="' + esc(d._key) + '" tabindex="0" role="button" aria-label="查看详情：' + esc(d.title) + '">'
    + '<div class="bl-title">' + mdInline(d.title) + '</div>'
    + (d.body ? '<div class="bl-note">' + esc(d.body.length > 90 ? d.body.slice(0, 90) + '…' : d.body) + '</div>' : '')
    + '<div class="bl-tags">' + tags + (d.issue ? '<span class="tag ok">外部 issue ↗</span>' : '') + '<span class="date">' + esc((d.created || '').slice(5)) + '</span></div>'
    + '</article>';
}

function projectSwitcherOpen() {
  return !!(projectSwitcher && projectSwitcher.classList.contains('open'));
}

function setProjectSwitcherOpen(open) {
  if (!projectSwitcher || !projectSwitcherTrigger) return;
  projectSwitcher.classList.toggle('open', !!open);
  projectSwitcherTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  var listbox = root.querySelector('#p-topbar').querySelector('[role="listbox"]');
  if (listbox) listbox.classList.toggle('open', !!open);
}

function closeProjectSwitcher() {
  setProjectSwitcherOpen(false);
}

function highlightProjectOption(index) {
  if (!projectSwitcherOptions.length) return;
  activeProjectIndex = (index + projectSwitcherOptions.length) % projectSwitcherOptions.length;
  projectSwitcherOptions.forEach(function (option, optionIndex) {
    option.classList.toggle('active', optionIndex === activeProjectIndex);
  });
}

function navigateProject(switcher) {
  if (!switcher) return;
  if (!switcher.value) switcher.value = switcher.getAttribute('data-href');
  if (switcher.value) window.location.href = switcher.value;
}

function bindProjectSwitcher(projects) {
  var topbar = root.querySelector('#p-topbar');
  projectSwitcher = root.querySelector('.project-switch');
  projectSwitcherTrigger = projectSwitcher && topbar.querySelector('.project-switch-trigger, [data-switcher-trigger]');
  projectSwitcherOptions = projectSwitcher ? Array.from(topbar.querySelectorAll('[role="option"]')) : [];
  activeProjectIndex = Math.max(0, projects.findIndex(function (item) { return !!item.current; }));
  if (!projectSwitcherTrigger) return;
  projectSwitcherTrigger.addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation();
