def render_all_html(agg):
    return ALL_HTML_TEMPLATE.replace("__EO_BOARD_ALL_DATA_JSON__", embed_json(agg))


def cmd_all(args):
    if args.serve:
        return cmd_all_serve(args)
    try:
        agg = build_all_data(scan_dir=args.scan)
    except ConfigError as e:
        die(f"❌ {e}")
    if args.html:
        return cmd_all_html(agg, args)
    if not agg["reg_count"] and not agg["scanned_count"]:
        print(f"注册表为空（{agg['registry_path']}）。")
        print("  在项目目录运行 eo-board --register 注册项目；")
        print("  或用 eo-board --all --scan <父目录> 临时聚合未注册项目（不写注册表）。")
