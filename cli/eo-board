        "diverged": bool(rec.get("diverged", False)),
        "fork_count": len(rec.get("forks") or []),
        "activity_at": rec.get("activity_at"),
        "active": is_recent(rec.get("activity_at")),
        "project": project_label,
        "route_key": route_key,
    }


def _aggregate_row(kind, obj, get_entry=_fresh_entry, embed_board=False):
    """聚合单项目行数据。kind: "registry"（注册条目）| "scan"（扫描兜底纳入）。
    get_entry(cfg) -> (data, as_of)：单次运行直连 build_data，serve 走缓存槽（as-of 保持构建时刻）。
    出错只落到本行 error，不中断其余项目。"""
    if kind == "registry":
        if entry_path(obj) is None:
            return {"label": f"{obj!r}"[:48], "path": "?", "registered": True,
                    "error": "注册条目非法（path 缺失或不是字符串）"}
        path = Path(obj["path"])
        label = obj.get("name") if isinstance(obj.get("name"), str) else path.name
    else:
        path, label = obj, obj.name
    row = {"label": label, "path": str(path), "registered": kind == "registry", "error": None}
    cfg_path = path / ".eo-project.json"
    if not cfg_path.is_file():
        row["error"] = "路径失效或缺 .eo-project.json"
        return row
    try:
        cfg = load_project_config(cfg_path)
        data, as_of = get_entry(cfg)
    except ConfigError as e:
        row["error"] = str(e)
        return row
    except Exception as e:
        row["error"] = f"扫描失败：{e}"
        return row
    counts = {}
    for c in data["changes"]:
        counts[c["status"]] = counts.get(c["status"], 0) + 1
    reg_name = obj.get("name") if kind == "registry" else None
    label = cfg["project_name"]
    key = make_route_key(label, path)
    main_wt = data["worktrees"][0] if data["worktrees"] else {}
    row.update({
        "label": label,
        "route_key": key,
        "counts": counts,
        "backlog": len(data["backlog"]),
        "as_of": as_of,
        "name_mismatch": reg_name if (reg_name and reg_name != cfg["project_name"]) else None,
        "main_branch": main_wt.get("branch"),
        "worktree_count": data["scanned_worktrees"],
        "activity_at": data["activity_at"],
        "active": is_recent(data["activity_at"]),
        "changes": [
            _stream_change(c, label, key) for c in data["changes"] if c["status"] != "archived"
        ],
    })
    if embed_board:
        row["board"] = data
    return row


def collect_sources(scan_dir=None, cwd_dir=None, explicit_dir=None):
    """当前聚合来源（注册条目 + cwd 项目 + --scan 兜底并入），返回 (sources, entries, scanned)。"""
    reg = load_registry()
    entries = list(reg.get("projects") or [])
    known = {repo_identity(p) for p in map(entry_path, entries) if p}
    scanned = []
    explicit_source = None
    if explicit_dir is not None:
        explicit = Path(explicit_dir).expanduser().resolve()
        exact_index = next(
            (
                i for i, entry in enumerate(entries)
                if entry_path(entry) and Path(entry_path(entry)).expanduser().resolve() == explicit
            ),
            None,
        )
        if exact_index is not None:
            entries = [entries[exact_index]] + entries[:exact_index] + entries[exact_index + 1:]
        else:
            explicit_source = ("scan", explicit)
            scanned.append(explicit)
            known.add(repo_identity(explicit))
    start = Path(cwd_dir or Path.cwd()).expanduser().resolve()
    cwd_cfg = find_project_config(start)
    if cwd_cfg is not None:
        cwd_project = cwd_cfg.parent
        ident = repo_identity(cwd_project)
        if ident not in known:
            known.add(ident)
            scanned.append(cwd_project)
    if scan_dir:
        parent = Path(scan_dir).expanduser().resolve()
        if not parent.is_dir():
            raise ConfigError(f"--scan 目录不存在：{parent}")
        for project_dir in _scan_parent_dir(parent, entries):
            ident = repo_identity(project_dir)
            if ident not in known:
                known.add(ident)
                scanned.append(project_dir)
    sources = ([explicit_source] if explicit_source else [])
    sources += [("registry", e) for e in entries]
    sources += [("scan", p) for p in scanned if explicit_source is None or p != explicit_source[1]]
    return sources, entries, scanned


def build_route_map(scan_dir=None, cwd_dir=None, explicit_dir=None):
    """当前 sources → {route_key: cfg}。逐请求重建，新注册 / 新 scan 到的项目立即可下钻；
    配置读不出来的条目不进映射，下钻落到指引页而不是 500。"""
    mapping = {}
    for kind, obj in collect_sources(scan_dir, cwd_dir=cwd_dir, explicit_dir=explicit_dir)[0]:
        if kind == "registry":
            raw = entry_path(obj)
            if raw is None:
                continue
            path = Path(raw)
        else:
            path = obj
        cfg_path = path / ".eo-project.json"
        if not cfg_path.is_file():
            continue
        try:
            cfg = load_project_config(cfg_path)
        except ConfigError:
            continue
        mapping[make_route_key(cfg["project_name"], path)] = cfg
    return mapping


def lookup_route(routes, key):
    """先按 key 原样匹配；未命中时按解码后的可读名比对，容忍客户端未编码直接发中文路径。"""
    if key in routes:
        return routes[key]
    decoded = url_unquote(key)
    for candidate, cfg in routes.items():
        if url_unquote(candidate) == decoded:
            return cfg
    return None


def build_all_data(scan_dir=None, get_entry=_fresh_entry, embed_board=False, cwd_dir=None, explicit_dir=None):
    """产出结构化聚合数据（rows/reg_count/scanned_count）。注册表每次调用重读——serve
    逐请求调用即天然纳入新注册项目；--scan 同步逐次重枚举。损坏注册表抛 ConfigError，调用方分流。"""
    sources, entries, scanned = collect_sources(scan_dir, cwd_dir=cwd_dir, explicit_dir=explicit_dir)

    def _safe_row(source):
        kind, obj = source
        try:
            return _aggregate_row(kind, obj, get_entry, embed_board=embed_board)
        except Exception as e:
            # 单条目兜底：任何未预期异常都只坏本行，绝不终止整体聚合
            return {"label": f"{obj!r}"[:48], "path": "?", "registered": kind == "registry",
                    "error": f"条目处理异常：{e}"}

    rows = []
    if sources:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, len(sources))) as pool:
            rows = list(pool.map(_safe_row, sources))
    drillable = [
        {"name": row["label"], "route_key": row["route_key"]}
        for row in rows if not row.get("error") and row.get("route_key")
    ]
    for row in rows:
        board = row.get("board")
        if not board:
            continue
        board["dashboard_projects"] = [
            {
                "name": item["name"],
                "href": f"#/p/{item['route_key']}",
                "current": item["route_key"] == row.get("route_key"),
            }
            for item in drillable
        ]
    return {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "serve": False,
        "registry_path": str(registry_path()),
        "reg_count": len(entries),
        "scanned_count": len(scanned),
        "rows": rows,
    }


def _scan_parent_dir(parent, entries):
    """一层枚举含 .eo-project.json 的子目录，剔除已注册者与本轮已发现的同仓 worktree
    （repo identity 判等，一个 identity 一行）。绝不写注册表。"""
    known = {repo_identity(p) for p in map(entry_path, entries) if p}
    found = []
    for child in sorted(parent.iterdir()):
        if child.is_dir() and (child / ".eo-project.json").is_file():
            ident = repo_identity(child)
            if ident not in known:
                known.add(ident)
                found.append(child)
    return found


def render_all_terminal(agg):
    rows, reg_count, scanned_count = agg["rows"], agg["reg_count"], agg["scanned_count"]
    out = [f"eo board · 全局 dashboard · 注册 {reg_count} 项目"
           + (f"（另扫描并入 {scanned_count}）" if scanned_count else "")
           + f" · {agg['registry_path']}", ""]
    header = ["项目", "draft", "confirmed", "implementing", "reviewed", "archived", "backlog", "as-of"]
    table, errors, notes = [], [], []
    for row in rows:
        name = row["label"] + ("" if row["registered"] else " (未注册)")
        if row["error"]:
            errors.append(f"  {name}  ✗ {row['error']}（{row['path']}）")
            continue
        counts = row["counts"]
        table.append([
            name,
            str(counts.get("draft", 0)),
            str(counts.get("confirmed", 0)),
            str(counts.get("implementing", 0)),
            str(counts.get("reviewed", 0)),
            str(counts.get("archived", 0)),
            str(row["backlog"]),
            row["as_of"],
        ])
        if row.get("name_mismatch"):
            notes.append(f"  ⚠ {row['label']}：注册名 {row['name_mismatch']} 与项目配置不一致，已按配置显示")
    if table:
        widths = [max(len(r[i]) for r in table + [header]) for i in range(len(header))]
        out.append("  " + "  ".join(header[i].ljust(widths[i]) for i in range(len(header))))
        for r in table:
            out.append("  " + "  ".join(r[i].ljust(widths[i]) for i in range(len(header))))
    for line in errors:
        out.append(line)
    for line in notes:
        out.append(line)
    out.append("")
    if scanned_count:
        out.append("提示：(未注册) 项目可在其目录运行 eo-board --register 收编。")
    out.append("下钻：eo-board --project <路径|注册名>")
    return "\n".join(out)


