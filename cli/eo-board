PXX_HEADING_TMPL = r"^#{{3,4}}\s*\[{prefix}-[^\]]+\]\s*(.+?)\s*$"  # 编号后缀不限数字：实测有 P2-S1 / P1-D1 这类字母后缀
CHANGE_REVIEW_ROUND_RE = re.compile(
    r"^##\s*复审记录\s*[（(]第\s*(\d+)\s*轮\s*[·・]\s*(增量|全量)\s*[·・]\s*([\d-]+)[）)]",
    re.MULTILINE,
)
ACCEPTANCE_CHECK_RE = re.compile(r"^-\s*\[([ xX])\]\s*通过")


def file_last_touch(worktree_path, rel_path):
    out = run_git(["log", "--all", "-1", "--format=%cI", "--", rel_path], cwd=worktree_path).strip()
    if out:
        return out[:10]
    full = Path(worktree_path) / rel_path
    if full.is_file():
        return datetime.fromtimestamp(full.stat().st_mtime).strftime("%Y-%m-%d")
    return None


def split_by_h2(text):
    """按任意 `## ` 标题切分（区别于 change.md 的按数字编号切分），用于报告类文件。"""
    sections, cur_title, cur_lines = [], None, []
    for line in text.splitlines():
        if line.startswith("## "):
            sections.append((cur_title, cur_lines))
            cur_title, cur_lines = line[3:].strip(), []
        else:
            cur_lines.append(line)
    sections.append((cur_title, cur_lines))
    return sections


def parse_pxx_headings(text, prefix):
    pat = re.compile(PXX_HEADING_TMPL.format(prefix=re.escape(prefix)), re.MULTILINE)
    return [m.group(1).strip() for m in pat.finditer(text)]


def parse_speed_report(text):
    """定位末节标题含"速报"的节，抓「结论：」「下一步：」两行；解析不出返回 (None, None)——
    容错优先，宁可不给结论也不误判卡点。"""
    lines = text.splitlines()
    start = None
    for i, line in enumerate(lines):
        if re.match(r"^##\s*.*速报", line.strip()):
            start = i
    if start is None:
        return None, None
    verdict, next_step = None, None
    for line in lines[start + 1:]:
        s = line.strip()
        m = re.match(r"^结论[:：]\s*(.+)$", s)
        if m:
            verdict = m.group(1).strip()
            continue
        m = re.match(r"^下一步[:：]\s*(.+)$", s)
        if m:
            next_step = m.group(1).strip()
    return verdict, next_step


def estimate_rounds_approx(fm, worktree_path, rel_path):
    """review.md/test.md 没有显式轮次字段，只能估算：commit 数（未提交存在时至少 1）
    与 frontmatter updated>created 信号（成立则至少 2），取两者较大值。"""
    out = run_git(["log", "--all", "--oneline", "--", rel_path], cwd=worktree_path)
    commit_n = len([l for l in out.splitlines() if l.strip()])
    git_based = commit_n if commit_n > 0 else 1
    created, updated = fm.get("created"), fm.get("updated")
    fm_based = 2 if (created and updated and str(updated) > str(created)) else 1
    return max(git_based, fm_based)


def parse_review_gate(path, worktree_path, rel_path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"review.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    fm, body = split_frontmatter(text)
    fm = fm or {}
    p0_titles = parse_pxx_headings(body, "P0")
    p1_titles = parse_pxx_headings(body, "P1")
    p2_titles = parse_pxx_headings(body, "P2")
    verdict, next_step = parse_speed_report(body)
    return {
        "exists": True,
        "rounds_approx": estimate_rounds_approx(fm, worktree_path, rel_path),
        "verdict": verdict,
        "next": next_step,
        "p0": len(p0_titles),
        "p1": len(p1_titles),
        "p2": len(p2_titles),
        "p0_titles": p0_titles[:3],
        "date": fm.get("updated") or fm.get("created"),
    }


def parse_test_gate(path, worktree_path, rel_path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"test.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    fm, body = split_frontmatter(text)
    fm = fm or {}
    fail_titles = parse_pxx_headings(body, "FAIL")
    verdict, next_step = parse_speed_report(body)
    return {
        "exists": True,
        "rounds_approx": estimate_rounds_approx(fm, worktree_path, rel_path),
        "verdict": verdict,
        "next": next_step,
        "fail_count": len(fail_titles),
        "fail_titles": fail_titles[:3],
        "date": fm.get("updated") or fm.get("created"),
    }


def parse_finding_ledger_open_p0(body):
    """在「...台账」节里找 Markdown 表格，数级别=P0 且状态=open 的行；列位置按表头文字定位，
    找不到表头就退回模板默认列序（级别第 1 列、状态第 4 列）。"""
    target_lines = None
    for title, lines in split_by_h2(body):
        if title and "台账" in title:
            target_lines = lines
            break
    if target_lines is None:
        return 0
    table_rows = [l for l in target_lines if l.strip().startswith("|")]
    if not table_rows:
        return 0
    header_cells = [c.strip() for c in table_rows[0].strip().strip("|").split("|")]
    level_idx, status_idx = 1, 4
    for idx, cell in enumerate(header_cells):
        if "级别" in cell:
            level_idx = idx
        if "状态" in cell:
            status_idx = idx
    open_p0 = 0
    for row in table_rows[1:]:
        stripped = row.strip().strip("|")
        if re.fullmatch(r"[\s:|-]+", stripped):
            continue  # 表格分隔行
        cells = [c.strip() for c in stripped.split("|")]
        if len(cells) <= max(level_idx, status_idx):
            continue
        if cells[level_idx].upper() == "P0" and cells[status_idx].lower() == "open":
            open_p0 += 1
    return open_p0


def parse_change_review_gate(path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"change-review.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    fm, body = split_frontmatter(text)
    fm = fm or {}

    round_matches = list(CHANGE_REVIEW_ROUND_RE.finditer(body))
    rounds = 1 + len(round_matches)
    if round_matches:
        last = round_matches[-1]
        mode, round_date = last.group(2), last.group(3)
    else:
        mode, round_date = "全量", None  # 首轮无复审记录节，必为全量

    verdict, next_step = parse_speed_report(body)
    return {
        "exists": True,
        "rounds": rounds,
        "mode": mode,
        "open_p0": parse_finding_ledger_open_p0(body),
        "verdict": verdict,
        "next": next_step,
        "date": round_date or fm.get("created"),
    }


def parse_acceptance_gate(path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"acceptance.md 读取失败，仅报存在性：{path}（{e}）")
        return {"exists": True}
    total = unchecked = 0
    for line in text.splitlines():
        m = ACCEPTANCE_CHECK_RE.match(line.strip())
        if m:
            total += 1
            if m.group(1) == " ":
                unchecked += 1
    return {"exists": True, "total": total, "unchecked": unchecked}


def compute_gates(rec, doc_root, warnings):
    """汇总四类质量门文件，并合成单一 blocker：候选按 gate 文件末次触碰时间取最新一条。"""
    wt_path = rec["worktree"]
    rel_dir = f"{doc_root}/changes/{rec['dirname']}"
    dir_path = Path(wt_path) / rel_dir
    gates = {}
    candidates = []  # (touch_date, blocker_text)

    cr_path = dir_path / "change-review.md"
    if cr_path.is_file():
        g = parse_change_review_gate(cr_path, warnings)
        gates["change_review"] = g
        if g.get("open_p0"):
            text = f"change-review 第{g['rounds']}轮 · P0×{g['open_p0']} 未决"
            if g["rounds"] >= 3:
                text += "（已到轮限，待用户裁决）"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/change-review.md") or "", text))

    review_path = dir_path / "review.md"
    if review_path.is_file():
        g = parse_review_gate(review_path, wt_path, f"{rel_dir}/review.md", warnings)
        gates["review"] = g
        if g.get("verdict") and "不通过" in g["verdict"]:
            text = f"review P0×{g.get('p0', 0)} 待修"
            if g.get("rounds_approx", 1) >= 2:
                text += f"（第≈{g['rounds_approx']}轮）"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/review.md") or "", text))

    test_path = dir_path / "test.md"
    if test_path.is_file():
        g = parse_test_gate(test_path, wt_path, f"{rel_dir}/test.md", warnings)
        gates["test"] = g
        if g.get("verdict") and "不通过" in g["verdict"]:
            text = f"test 不通过 · FAIL×{g.get('fail_count', 0)}"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/test.md") or "", text))

    acc_path = dir_path / "acceptance.md"
    if acc_path.is_file():
        g = parse_acceptance_gate(acc_path, warnings)
        gates["acceptance"] = g
        if rec["status"] in ("reviewed", "implementing") and g.get("unchecked"):
            text = f"人工验收 {g['unchecked']} 项待勾"
            candidates.append((file_last_touch(wt_path, f"{rel_dir}/acceptance.md") or "", text))

    rec["gates"] = gates
    rec["blocker"] = max(candidates, key=lambda c: c[0])[1] if candidates else None


def compute_monthly_direct_commits(anchor_dir):
    since = date.today().replace(day=1).isoformat()
    out = run_git(["log", "--all", "--pretty=%s", "--since", since], cwd=str(anchor_dir))
    fix_n = sum(1 for s in out.splitlines() if s.startswith("fix:"))
    ui_n = sum(1 for s in out.splitlines() if s.startswith("ui:"))
    return {"fix": fix_n, "ui": ui_n, "total": fix_n + ui_n, "since": since}


