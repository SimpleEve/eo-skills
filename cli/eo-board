class AllBoardRequestHandler(http.server.BaseHTTPRequestHandler):
    scan_dir = None
    cwd_dir = None
    explicit_dir = None

    def log_message(self, fmt, *a):
        pass  # 静默：只读服务不需要逐请求刷屏

    def _send(self, status, content_type, body_bytes, message=None):
        self.send_response(status, message)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body_bytes)))
        self.end_headers()
        try:
            self.wfile.write(body_bytes)
        except (ConnectionResetError, BrokenPipeError):
            pass  # 静默：客户端断开连接时不刷栈

    def _routes(self):
        try:
            return build_route_map(
                self.scan_dir,
                cwd_dir=self.cwd_dir,
                explicit_dir=self.explicit_dir,
            )
        except ConfigError:
            return {}

    def _send_route_miss(self, key):
        self._send(404, "text/html; charset=utf-8",
                   render_route_miss(key, self._routes()).encode("utf-8"), message="Not Found")

    def _send_project(self, tail):
        want_json = tail.endswith("/data.json")
        key = tail[: -len("/data.json")] if want_json else tail.rstrip("/")
        cfg = lookup_route(self._routes(), key)
        if cfg is None:
            self._send_route_miss(key)
            return
        data = get_board_data_cached(cfg)
        data = dict(data)
        data["dashboard_projects"] = [
            {"name": item["project_name"], "href": f"/p/{route_key}", "current": route_key == key}
            for route_key, item in sorted(self._routes().items(), key=lambda pair: pair[1]["project_name"])
        ]
        if want_json:
            self._send(200, "application/json; charset=utf-8",
                       json.dumps(data, ensure_ascii=False).encode("utf-8"))
            return
        html = render_html(data, data_url=f"/p/{key}/data.json", home_url="/")
        self._send(200, "text/html; charset=utf-8", html.encode("utf-8"))

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            data = build_all_serve_data(
                self.scan_dir,
                cwd_dir=self.cwd_dir,
                explicit_dir=self.explicit_dir,
            )
            self._send(200, "text/html; charset=utf-8", render_all_html(data).encode("utf-8"))
        elif path == "/data.json":
            data = build_all_serve_data(
                self.scan_dir,
                cwd_dir=self.cwd_dir,
                explicit_dir=self.explicit_dir,
            )
            self._send(200, "application/json; charset=utf-8", json.dumps(data, ensure_ascii=False).encode("utf-8"))
        elif path.startswith("/p/"):
            self._send_project(path[len("/p/"):])
        elif path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
        else:
            self._send_route_miss(path)


def cmd_all_serve(args, cfg=None):
    if args.scan:
        parent = Path(args.scan).expanduser().resolve()
        if not parent.is_dir():
            die(f"❌ --scan 目录不存在：{parent}")
    explicit_dir = cfg["repo_root"] if cfg else None
    handler = type(
        "AllHandler",
        (AllBoardRequestHandler,),
        {"scan_dir": args.scan, "cwd_dir": explicit_dir, "explicit_dir": explicit_dir},
    )
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    except OSError as e:
        die(f"❌ 无法监听 127.0.0.1:{args.port}（{e}）——换个 --port 试试")
    url = f"http://127.0.0.1:{args.port}/"
    if cfg:
        url += f"p/{make_route_key(cfg['project_name'], cfg['repo_root'])}"
    print(f"eo-board 多项目聚合只读服务已启动：{url}（Ctrl+C 停止）")
    if not args.no_open:
        threading.Timer(0.3, safe_open, args=(url,)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n已停止。")
        server.shutdown()
    return 0


def resolve_project_token(token):
    """--project <路径|注册名> → 项目路径。目录存在按路径；否则查注册名，多命中报歧义不静默取首项。"""
    p = Path(token).expanduser()
    if p.is_dir():
        return p.resolve()
    try:
        reg = load_registry()
    except ConfigError as e:
        die(f"❌ {e}")
    hits = find_by_name(reg, token)
    if len(hits) > 1:
        lines = "\n".join(f"  - {h.get('path')}" for h in hits)
        die(f"❌ 注册名 {token} 命中多个项目，请改用路径：\n{lines}")
    if len(hits) == 1:
        hit_path = entry_path(hits[0])
        if hit_path is None:
            die(f"❌ 注册名 {token} 对应条目非法（path 缺失或不是字符串），请修复注册表或改用路径")
        return Path(hit_path)
    die(f"❌ --project {token} 既不是存在的目录，也不是注册名（eo-board 查看已注册项目）")


# ============================================================
# 注册表维护（唯一的写路径例外：写的是用户级 ~/.eo 注册表，不是项目文件）
# ============================================================

def cmd_register(path_str):
    start = Path(path_str).expanduser().resolve()
    cfg_path = find_project_config(start)
    if cfg_path is None:
        die(f"❌ 未找到 .eo-project.json（自 {start} 向上）——先运行 /eo-project-init 初始化项目。")
    try:
        cfg = load_project_config(cfg_path)
        result = register_project(cfg_path.parent, cfg["project_name"])
    except ConfigError as e:
        die(f"❌ {e}")
    entry = result["entry"]
    verb = "已注册" if result["action"] == "created" else "已更新注册（同一仓库，幂等）"
    print(f"✓ {verb}：{entry['name']} → {entry['path']}")
    if result["same_name"]:
        paths = "、".join(str(e.get("path")) for e in result["same_name"])
        print(f"⚠ 注册名 {entry['name']} 同名共存：{paths}——--project 按名解析遇歧义时请改用路径")
    return 0


def cmd_unregister(path_str):
    target = Path(path_str).expanduser().resolve()
    try:
        removed = unregister_project(target)
    except ConfigError as e:
        die(f"❌ {e}")
    if removed is None:
        die(f"未命中任何注册条目：{target}（用 eo-board 查看当前注册项目）")
    print(f"✓ 已移除注册：{removed.get('name')} → {removed.get('path')}")
    return 0


# ============================================================
# CLI 入口
# ============================================================

def build_arg_parser():
    parser = argparse.ArgumentParser(
        prog="eo-board",
        description="eo-skills 工作流的只读项目看板：从 .eo-project.json 出发，汇总多 worktree 的 change / backlog / roadmap。",
        epilog=(
            "示例：\n"
            "  eo-board                 全局 dashboard 终端摘要\n"
            "  eo-board --html          全局 dashboard 静态快照（写到 tmp 并自动打开）\n"
            "  eo-board --html -o a.html 生成到指定路径\n"
            "  eo-board --serve         全局 dashboard 本地服务（仅 127.0.0.1，默认 7333 端口）\n"
            "  eo-board --project X     下钻指定项目（路径或注册名），无需 cd\n"
            "  eo-board --register      把当前项目注册进用户级注册表\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
    )
    parser.add_argument("-h", "--help", action="help", default=argparse.SUPPRESS, help="显示本帮助信息并退出")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--html", action="store_true", help="生成全局 dashboard 自包含静态 HTML 快照")
    mode.add_argument("--serve", action="store_true", help="启动全局 dashboard 本地只读 HTTP 服务（仅绑 127.0.0.1）")
    mode.add_argument("--register", nargs="?", const=".", metavar="PATH",
                      help="把项目注册进用户级注册表 ${EO_HOME:-$HOME/.eo}/projects.json（缺省 PATH=当前目录）")
    mode.add_argument("--unregister", nargs="?", const=".", metavar="PATH",
                      help="从用户级注册表移除项目（缺省 PATH=当前目录）")
    parser.add_argument("--all", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--project", metavar="路径|注册名",
                        help="下钻指定项目（等价于在该目录运行，三形态通用），无需 cd")
    parser.add_argument("--scan", metavar="父目录",
                        help="把含 .eo-project.json 的一层子目录临时并入全局 dashboard（不写注册表）")
    parser.add_argument("-o", "--output", metavar="PATH", help="--html 模式下指定输出文件路径（默认写到系统 tmp 目录）")
    parser.add_argument("--port", type=int, default=None, help="--serve 模式下监听端口（默认 7333）")
    parser.add_argument("--no-open", action="store_true", help="--html/--serve 模式下生成/启动后不自动打开浏览器")
    parser._optionals.title = "选项"
    return parser


def main():
    parser = build_arg_parser()
    args = parser.parse_args()
    if args.output and not args.html:
        parser.error("-o/--output 仅在 --html 模式下有效")
    if args.all:
        parser.error("--all 已退役：全局 dashboard 已是默认形态，去掉该旗标即可")
    if args.scan and args.project:
        parser.error("--scan 只用于默认全局 dashboard，不与 --project 混用")
    if args.port is not None and not args.serve:
        parser.error("--port 仅在 --serve 模式下有效")
    if args.no_open and not (args.html or args.serve):
        parser.error("--no-open 仅在 --html/--serve 模式下有效")
    if (args.register is not None or args.unregister is not None) and (args.project or args.scan or args.output):
        parser.error("--register/--unregister 是注册表维护动作，不与 --project/--scan/-o 混用")
    if args.port is None:
        args.port = 7333

    if args.register is not None:
        sys.exit(cmd_register(args.register))
    if args.unregister is not None:
        sys.exit(cmd_unregister(args.unregister))
    if not args.project:
        sys.exit(cmd_all(args))

    start = resolve_project_token(args.project)
    cfg_path = find_project_config(start)
    if cfg_path is None:
        print("❌ 未找到 .eo-project.json", file=sys.stderr)
        print("请先运行 /eo-project-init 初始化项目。", file=sys.stderr)
        sys.exit(1)
    try:
        cfg = load_project_config(cfg_path)
    except ConfigError as e:
        print(f"❌ {e}", file=sys.stderr)
        print(
            "请检查配置或运行 /eo-project-init 修复；协作者 clone 场景可用 .eo-project.local.json 提供机器相关字段。",
            file=sys.stderr,
        )
        sys.exit(1)

    if args.serve:
        cmd_all_serve(args, cfg=cfg)
    elif args.html:
        cmd_project_html(cfg, args)
    else:
        cmd_terminal(cfg)


if __name__ == "__main__":
    main()
