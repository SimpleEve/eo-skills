function buildBoard() {
  CARD_INDEX = {};
  var html = '';
  STATUS_ORDER.forEach(function (status) {
    var col = (status === 'backlog')
      ? DATA.backlog
      : DATA.changes.filter(function (c) { return c.status === status; });
    var st = STATUS[status];
    html += '<section class="col" style="--col-color: var(' + st.cssVar + ')">'
      + '<div class="col-head"><span class="dot"></span><span class="name">' + st.zh + '</span>'
      + '<span class="en">' + status + '</span><span class="count">' + col.length + '</span></div><div class="cards">';
    if (!col.length) {
      html += '<div class="empty-hint">（无）</div>';
    }
    col.forEach(function (d) {
      d._key = (status === 'backlog' ? 'bl:' : 'ch:') + (d.id || d.path);
      CARD_INDEX[d._key] = d;
      html += status === 'backlog' ? backlogCard(d) : changeCard(d);
    });
    html += '</div>';
    if (status === 'backlog' && DATA.backlog_archive && DATA.backlog_archive.count) {
      html += '<div class="col-note">archive/ 另有 ' + DATA.backlog_archive.count + ' 张：adopted×' + DATA.backlog_archive.adopted + ' · dropped×' + DATA.backlog_archive.dropped + '<span class="src">backlog/archive/</span></div>';
    }
    if (status === 'implementing') html += '<div class="col-note">轻档无 TODO 节，只有 AC 进度；⚠ 为停滞提醒（轻档 &gt;30 天未动）</div>';
    if (status === 'reviewed') html += '<div class="col-note">轻档跳过本列：完成门通过即 archived</div>';
    html += '</section>';
  });
  document.getElementById('board').innerHTML = html;
  bindCardEvents();
}

var drawer = document.getElementById('drawer');
var backdrop = document.getElementById('backdrop');
var lastFocus = null;

function openDetail(key, isRefresh) {
  var d = CARD_INDEX[key];
  if (!d) return;
  openDetailId = key;
  var chips = d.kind === 'change'
    ? '<span class="seq">#' + esc(d.seq != null ? d.seq : '?') + '</span><span class="tier ' + esc(d.tier) + '">' + esc(d.tier) + '</span><span class="type">' + esc(d.type) + '</span>' + stPill(d.status)
    : stPill('backlog');
  document.getElementById('drawerChips').innerHTML = chips;
  document.getElementById('drawerTitle').textContent = d.title;
  document.getElementById('drawerBody').innerHTML = d.kind === 'change' ? renderChange(d) : renderBacklog(d);
  if (!isRefresh) document.getElementById('drawerBody').scrollTop = 0;
  drawer.classList.add('open');
  backdrop.classList.add('open');
  if (!isRefresh) { lastFocus = document.activeElement; document.getElementById('closeBtn').focus(); }
}

function closeDetail() {
  drawer.classList.remove('open');
  backdrop.classList.remove('open');
  openDetailId = null;
  if (lastFocus) lastFocus.focus();
}

function bindCardEvents() {
  document.querySelectorAll('.card[data-detail]').forEach(function (card) {
    card.addEventListener('click', function () { openDetail(card.dataset.detail); });
