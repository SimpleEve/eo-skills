    }
    if (searchOpen) {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        var delta = e.key === 'ArrowDown' ? 1 : -1;
        activeSearchIndex = Math.max(0, Math.min(searchResults.length - 1, activeSearchIndex + delta));
        renderSearchResults();
      } else if (e.key === 'Enter' && searchResults.length) {
        e.preventDefault(); locateSearchResult(activeSearchIndex);
