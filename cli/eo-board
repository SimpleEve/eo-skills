      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDetail(card.dataset.detail); }
    });
  });
}

document.getElementById('closeBtn').addEventListener('click', closeDetail);
backdrop.addEventListener('click', closeDetail);
document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && drawer.classList.contains('open')) closeDetail(); });

buildHeader();
buildBoard();

if (DATA.serve) {
  var lastHash = null;
  function hashStr(s) {
    var h = 5381;
    for (var i = 0; i < s.length; i++) { h = ((h << 5) + h + s.charCodeAt(i)) | 0; }
    return h;
  }
  function refreshLoop() {
    fetch('/data.json', { cache: 'no-store' }).then(function (r) { return r.text(); }).then(function (text) {
      var h = hashStr(text);
