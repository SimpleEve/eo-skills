// ── 安全迷你 markdown：白名单转换，且只作用在 esc() 之后的文本上 ──
// applyInline 的入参必须已经过 esc()；** / ` / []() 本身不在转义字符集里，转义后依旧原样可匹配，
// 而载荷里夹带的 <script> 等已经变成 &lt;script&gt;，转换只会把它们包进白名单标签，不会变回真标签。
function safeHref(url) {
  // 仅放行 http / https / mailto；javascript:、data: 等一律不生成 href
  var u = String(url || '').trim();
  if (!u) return null;
  var m = u.match(/^([a-zA-Z][a-zA-Z0-9+.-]*):/);
  if (!m) return null;
  var scheme = m[1].toLowerCase();
  if (scheme === 'http' || scheme === 'https' || scheme === 'mailto') return u;
  return null;
}

function applyInline(escapedText) {
  var s = escapedText.replace(/`([^`]+)`/g, function (_, code) { return '<code>' + code + '</code>'; });
  s = s.replace(/\*\*([^*]+)\*\*/g, function (_, b) { return '<strong>' + b + '</strong>'; });
  s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (_, t, u) {
    var href = safeHref(u);
    if (!href) return t; // 危险/未知协议：只保留可见文本，不生成 <a>
    return '<a href="' + href + '" rel="noopener noreferrer">' + t + '</a>';
  });
  return s;
}

function mdInline(raw) {
  return applyInline(esc(raw));
}

function mdIsTableSep(trimmed) {
  // | --- | :---: | ---: |
  return /^\|?(\s*:?-{3,}:?\s*\|)+\s*:?-{3,}:?\s*\|?\s*$/.test(trimmed);
}

function mdSplitRow(trimmed) {
  var s = trimmed;
  if (s.charAt(0) === '|') s = s.slice(1);
  if (s.charAt(s.length - 1) === '|') s = s.slice(0, -1);
  return s.split('|').map(function (c) { return c.trim(); });
}

// 一层嵌套：无序/有序/task checkbox；缩进行归入上一个顶层 li
function mdList(lines, startIdx) {
  var top = [];
  var i = startIdx;
  var ordered = null;
  while (i < lines.length) {
    var mTask = lines[i].match(/^(\s*)[-*+]\s+\[([ xX])\]\s+(.*)$/);
    var mUl = !mTask && lines[i].match(/^(\s*)[-*+]\s+(.*)$/);
    var mOl = !mTask && !mUl && lines[i].match(/^(\s*)(\d+)\.\s+(.*)$/);
    if (!mTask && !mUl && !mOl) break;
    var indent, body, task = null;
    if (mTask) {
      indent = mTask[1].length; body = mTask[3]; task = mTask[2].toLowerCase() === 'x';
      if (ordered === null) ordered = false;
    } else if (mUl) {
      indent = mUl[1].length; body = mUl[2];
      if (ordered === null) ordered = false;
    } else {
      indent = mOl[1].length; body = mOl[3];
      if (ordered === null) ordered = true;
    }
    var text = applyInline(body);
    var item = { text: text, sub: [], task: task };
    if (indent === 0 || !top.length) {
      top.push(item);
    } else {
      top[top.length - 1].sub.push(text);
    }
    i++;
  }
  var tag = ordered ? 'ol' : 'ul';
  var html = '<' + tag + '>' + top.map(function (it) {
    var cls = it.task === null || it.task === undefined ? '' : ' class="task"';
    var box = (it.task === null || it.task === undefined) ? ''
      : '<input type="checkbox" disabled' + (it.task ? ' checked' : '') + '> ';
    return '<li' + cls + '>' + box + it.text
      + (it.sub.length ? '<ul>' + it.sub.map(function (s) { return '<li>' + s + '</li>'; }).join('') + '</ul>' : '')
      + '</li>';
  }).join('') + '</' + tag + '>';
  return { html: html, next: i };
