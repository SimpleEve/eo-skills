def build_arg_parser():
    parser = argparse.ArgumentParser(
        prog="eo-board",
        description="eo-skills 工作流的只读项目看板：从 .eo-project.json 出发，汇总多 worktree 的 change / backlog / roadmap。",
        epilog=(
            "示例：\n"
            "  eo-board                 终端摘要\n"
            "  eo-board --html          生成静态 HTML 快照（写到 tmp 并自动打开）\n"
            "  eo-board --html -o a.html 生成到指定路径\n"
            "  eo-board --serve         本地只读服务（仅 127.0.0.1，默认 7333 端口）\n"
            "  eo-board --all           多项目聚合总览（读 ${EO_HOME:-$HOME/.eo}/projects.json）\n"
            "  eo-board --all --html    多项目一页看板静态快照\n"
            "  eo-board --all --serve   多项目一页看板本地服务（3 秒热刷新）\n"
            "  eo-board --project X     下钻指定项目（路径或注册名），无需 cd\n"
            "  eo-board --register      把当前项目注册进用户级注册表\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
    )
    parser.add_argument("-h", "--help", action="help", default=argparse.SUPPRESS, help="显示本帮助信息并退出")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--html", action="store_true", help="生成自包含静态 HTML 快照（可与 --all 组合）")
    mode.add_argument("--serve", action="store_true", help="启动本地只读 HTTP 服务（仅绑 127.0.0.1，可与 --all 组合）")
    mode.add_argument("--register", nargs="?", const=".", metavar="PATH",
                      help="把项目注册进用户级注册表 ${EO_HOME:-$HOME/.eo}/projects.json（缺省 PATH=当前目录）")
    mode.add_argument("--unregister", nargs="?", const=".", metavar="PATH",
                      help="从用户级注册表移除项目（缺省 PATH=当前目录）")
    parser.add_argument("--all", action="store_true",
                        help="多项目聚合总览（终端形态；配 --html/--serve 得多项目一页看板）")
    parser.add_argument("--project", metavar="路径|注册名",
                        help="下钻指定项目（等价于在该目录运行，三形态通用），无需 cd")
    parser.add_argument("--scan", metavar="父目录",
                        help="--all 模式下把含 .eo-project.json 的一层子目录临时并入聚合（不写注册表）")
    parser.add_argument("-o", "--output", metavar="PATH", help="--html 模式下指定输出文件路径（默认写到系统 tmp 目录）")
    parser.add_argument("--port", type=int, default=7333, help="--serve 模式下监听端口（默认 7333）")
    parser.add_argument("--no-open", action="store_true", help="生成/启动后不自动打开浏览器")
    parser._optionals.title = "选项"
    return parser


def main():
    parser = build_arg_parser()
    args = parser.parse_args()
    if args.output and not args.html:
        parser.error("-o/--output 仅在 --html 模式下有效")
    if args.scan and not args.all:
        parser.error("--scan 仅在 --all 模式下有效")
    if args.project and args.all:
        parser.error("--project 与 --all 互斥（--project 是单项目下钻）")
    if (args.register is not None or args.unregister is not None) and (args.all or args.project or args.output):
        parser.error("--register/--unregister 是注册表维护动作，不与 --all/--project/-o 混用")

    if args.register is not None:
        sys.exit(cmd_register(args.register))
    if args.unregister is not None:
        sys.exit(cmd_unregister(args.unregister))
    if args.all:
        sys.exit(cmd_all(args))

    start = resolve_project_token(args.project) if args.project else Path.cwd()
    cfg_path = find_project_config(start)
    if cfg_path is None:
        print("❌ 未找到 .eo-project.json", file=sys.stderr)
        print("请先运行 /eo-project-init 初始化项目。", file=sys.stderr)
        sys.exit(1)
    try:
        cfg = load_project_config(cfg_path)
    except ConfigError as e:
        print(f"❌ {e}", file=sys.stderr)
        print(
            "请检查配置或运行 /eo-project-init 修复；协作者 clone 场景可用 .eo-project.local.json 提供机器相关字段。",
            file=sys.stderr,
        )
        sys.exit(1)

    if args.serve:
        cmd_serve(cfg, args)
    elif args.html:
        cmd_html(cfg, args)
    else:
        cmd_terminal(cfg)


if __name__ == "__main__":
    main()
