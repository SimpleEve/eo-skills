def parse_backlog_file(path, warnings):
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as e:
        warnings.append(f"backlog 卡读取失败，已跳过：{path}（{e}）")
        return None
    fm, body = split_frontmatter(text)
    if fm is None:
        warnings.append(f"backlog 卡缺少 frontmatter，已跳过：{path}")
        return None
    return {
        "kind": "backlog",
        "id": path.stem,
        "title": fm.get("title") or path.stem,
        "status": fm.get("status") or "backlog",
        "tags": fm.get("tags") or [],
        "created": fm.get("created"),
        "issue": fm.get("issue"),
        "body": body.strip(),
        "path": str(path),
    }


def scan_backlog_dir(dir_path, warnings):
    if not dir_path.is_dir():
        return []
    return [
        rec
        for f in sorted(dir_path.glob("*.md"))
        for rec in [parse_backlog_file(f, warnings)]
        if rec is not None
    ]


def scan_backlog_archive(dir_path, warnings):
    arc = dir_path / "archive"
    stats = {"count": 0, "adopted": 0, "dropped": 0}
    if not arc.is_dir():
        return stats
    for f in sorted(arc.glob("*.md")):
        stats["count"] += 1
        rec = parse_backlog_file(f, warnings)
        if rec and rec["status"] == "adopted":
            stats["adopted"] += 1
        elif rec and rec["status"] == "dropped":
            stats["dropped"] += 1
    return stats


def scan_backlog_all(cfg, worktrees, warnings):
    if cfg["mode"] == "vault" and cfg.get("project_root"):
        root = Path(cfg["project_root"]) / "backlog"
        cards = scan_backlog_dir(root, warnings)
        archive_stats = scan_backlog_archive(root, warnings)
    else:
        # local 模式：.eo-project/ 是 gitignored 目录，各 worktree 独立，需逐个合并扫
        cards, seen = [], set()
        archive_stats = {"count": 0, "adopted": 0, "dropped": 0}
        for wt in worktrees:
            root = Path(wt["path"]) / ".eo-project" / "backlog"
            for c in scan_backlog_dir(root, warnings):
                if c["path"] in seen or Path(c["path"]).name in {Path(x).name for x in seen}:
                    continue
                seen.add(c["path"])
                c["worktree"] = wt["path"]
                cards.append(c)
            arc = scan_backlog_archive(root, warnings)
            for k in archive_stats:
                archive_stats[k] += arc[k]
    cards.sort(key=lambda c: c.get("created") or "")
    return cards, archive_stats


def read_roadmap(project_root, warnings):
    if not project_root:
        return None
    path = Path(project_root) / "roadmap.md"
    if not path.is_file():
        return None
    try:
        fm, _ = split_frontmatter(path.read_text(encoding="utf-8"))
        if fm is None:
            return None
        return {
            "status": fm.get("status"),
            "phase": fm.get("phase"),
            "summary": fm.get("summary"),
            "updated": fm.get("updated"),
            "path": str(path),
        }
    except Exception as e:
        warnings.append(f"roadmap.md 解析失败：{path}（{e}）")
        return None


