def iso_seconds(ts):
    """epoch 秒 → 带本地时区偏移的秒级 ISO 8601。"""
    return datetime.fromtimestamp(ts).astimezone().replace(microsecond=0).isoformat()


def parse_iso(value):
    """解析 ISO 8601（git %cI 或本函数产出）；无时区的按本地时区补齐，不可解析返回 None。"""
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value))
    except (TypeError, ValueError):
        return None
    return dt if dt.tzinfo else dt.astimezone()


def max_activity(*values):
    """取最新的时间戳，统一归一到本地时区秒级表示；全部不可解析返回 None。"""
    best = None
    for v in values:
        dt = parse_iso(v)
        if dt is not None and (best is None or dt > best):
            best = dt
    return iso_seconds(best.timestamp()) if best is not None else None


def is_recent(activity_at, now=None):
    dt = parse_iso(activity_at)
    if dt is None:
        return False
    now = now or datetime.now().astimezone()
    return (now - dt) <= timedelta(days=ACTIVE_WINDOW_DAYS)


def make_route_key(display_name, project_dir):
    """`/p/<URL 编码可读名>~<项目根 canonical 路径 hash8>` 的 key 部分。

    显示名不承担唯一性：同名项目、注册名与配置名不一致、CJK 名均由 hash8 区分。
    """
    digest = hashlib.sha256(str(Path(project_dir).resolve()).encode("utf-8")).hexdigest()[:8]
    return f"{quote(str(display_name), safe='')}~{digest}"


