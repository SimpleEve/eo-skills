def fmt_progress(done, total):
    return f"{done}/{total}" if total else "-"


def render_terminal(data):
    out = []
    proj = data["project"]
    out.append(f"eo board · {proj['name']} ({proj['mode']})")
    rm = data["roadmap"]
    if rm:
        parts = [p for p in (rm.get("status"), rm.get("phase")) if p]
        line = "roadmap：" + (" · ".join(parts) if parts else "（缺少 status/phase）")
        if rm.get("updated"):
            line += f"  updated {rm['updated']}"
        out.append(line)
    else:
        out.append("roadmap：未找到 roadmap.md（降级显示）")
    out.append(f"扫描了 {data['scanned_worktrees']} 个 worktree · 生成于 {data['generated_at']}")
    out.append("")

    by_status = {s: [] for s in CHANGE_STATUS_ORDER}
    for c in data["changes"]:
        by_status.setdefault(c["status"], []).append(c)

    for status in CHANGE_STATUS_ORDER:
        items = sorted(by_status.get(status, []), key=lambda c: (c.get("seq") is None, c.get("seq") or 0))
        out.append(f"[{status} · {STATUS_ZH[status]}] ({len(items)})")
        if not items:
            out.append("  （无）")
            out.append("")
            continue
        header = ["SEQ", "SLUG", "TIER", "TYPE", "AC", "TODO", "分支", "警告"]
        rows = []
        for c in items:
            seq = f"#{c['seq']}" if c.get("seq") is not None else "#?"
            ac_done, ac_total = count_ac(c["ac"])
            if c["todo"] is not None:
                todo_str = fmt_progress(*count_todo(c["todo"]))
            else:
                todo_str = "-"
            branch = "-"
            if not c.get("is_default_worktree"):
                branch = f"⎇{c.get('branch') or '?'}@{c.get('worktree_name')}"
            if c.get("forks"):
                marker = f"分叉×{len(c['forks'])}"
                branch = f"{branch} {marker}" if branch != "-" else marker
            warn_parts = []
            if c.get("stale"):
                warn_parts.append(f"⚠ {c['stale_days']}天未动")
            if c.get("blocker"):
                b = c["blocker"]
                warn_parts.append("⛔ " + (b if len(b) <= 24 else b[:24] + "…"))
            warn = " ".join(warn_parts)
            rows.append(
                [seq, c["id"], c["tier"], c["type"], fmt_progress(ac_done, ac_total), todo_str, branch, warn]
            )
        widths = [max(len(r[i]) for r in rows + [header]) for i in range(8)]
        out.append("  " + "  ".join(header[i].ljust(widths[i]) if i < 7 else header[i] for i in range(8)))
        for r in rows:
            out.append("  " + "  ".join(r[i].ljust(widths[i]) if i < 7 else r[i] for i in range(8)))
        out.append("")

    out.append(f"[backlog · 待办池] ({len(data['backlog'])})")
    if not data["backlog"]:
        out.append("  （无）")
    else:
        for card in data["backlog"]:
            tags = " ".join(card.get("tags") or [])
            out.append(f"  {card.get('created') or '?'}  {card['title']}" + (f"  [{tags}]" if tags else ""))
    arc = data["backlog_archive"]
    if arc["count"]:
        out.append(f"  archive/：{arc['count']} 张（adopted×{arc['adopted']} · dropped×{arc['dropped']}）")
    out.append("")

    if data["warnings"]:
        out.append(f"⚠ 警告 ({len(data['warnings'])})：")
        for w in data["warnings"]:
            out.append(f"  - {w}")
        out.append("")

    st = data["stats"]
    dc = st["direct_commits"]
    out.append(
        f"统计：活跃 change {st['active_changes']} · backlog {st['backlog_count']} · "
        f"本月直改 {dc['total']}（fix:×{dc['fix']} · ui:×{dc['ui']}） · "
        f"停滞提醒 {st['stale_count']} · 卡点 {st['blocked_count']}"
    )
    return "\n".join(out)


