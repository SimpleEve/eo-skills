      } else if (e.key === 'Enter' && projectSwitcherOptions.length) {
        e.preventDefault();
        navigateProject(projectSwitcherOptions[activeProjectIndex]);
      }
      return;
    }
    var cmdK = e.key.toLocaleLowerCase() === 'k' && (e.metaKey || e.ctrlKey);
    var slash = e.key === '/' && !isTextInput(e.target);
    if (cmdK || slash) { e.preventDefault(); openSearch(); }
  };
  clickHandler = function (e) {
    if (projectSwitcherOpen() && !projectSwitcher.contains(e.target)) closeProjectSwitcher();
    if (!locatedKey || !root.contains(e.target)) return;
    if (!e.target.closest('.card') && !e.target.closest('.search-panel')) clearLocate();
  };
  document.addEventListener('keydown', keyHandler);
  document.addEventListener('click', clickHandler);
  buildHeader();
  buildBoard();
  if (DATA.serve && typeof fetch === 'function') startPolling();
}

function unmount() {
  if (timer !== null) { clearInterval(timer); timer = null; }
