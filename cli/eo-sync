PROTOCOL_VERSION = 1
ADAPTER_PREFIX = "eo-sync-"
STALE_LOCK_SECONDS = 600

# change 生命周期保留键：适配器不得声明为身份字段，也不得回写
RESERVED_CHANGE_KEYS = {
    "id", "seq", "title", "summary", "status", "tier", "type",
    "base_commit", "plan_revision", "fix_rounds", "fix_consumed",
    "commits", "created",
}
FIELD_NAME_RE = re.compile(r"^[a-z][a-z0-9_]*$")

EXIT_OK = 0
EXIT_FAILURE = 1
EXIT_LOCKED = 2


# --------------------------------------------------------------------------- 发现与协议

def discover_adapters():
    """扫描 PATH 上的 eo-sync-* 可执行文件，按 name 去重（PATH 靠前者胜）。返回 {name: path}。"""
    found = {}
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        d = Path(entry)
        if not d.is_dir():
            continue
        try:
            children = sorted(d.iterdir())
        except OSError:
            continue
        for child in children:
            name = child.name
            if not name.startswith(ADAPTER_PREFIX) or len(name) <= len(ADAPTER_PREFIX):
                continue
            adapter_name = name[len(ADAPTER_PREFIX):]
            if adapter_name in found:
                continue
            if child.is_file() and os.access(str(child), os.X_OK):
                found[adapter_name] = str(child.resolve())
    return found


def invoke_adapter(exe_path, verb, request, timeout):
    """调用 `eo-sync-<name> <verb>`，stdin JSON 请求，stdout JSON 响应。

    返回 (响应 dict, None) 或 (None, 错误文本)。协议主版本不匹配 / 非法 JSON / 非零退出均返回错误。
    """
    payload = dict(request)
    payload["protocol_version"] = PROTOCOL_VERSION
    payload["verb"] = verb
    try:
        proc = subprocess.run(
            [exe_path, verb],
            input=json.dumps(payload, ensure_ascii=False),
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return None, f"{verb} 超时（>{timeout}s）"
    except OSError as e:
        return None, f"{verb} 无法启动：{e}"
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        return None, f"{verb} 退出码 {proc.returncode}：{detail[0] if detail else '无 stderr'}"
    try:
        resp = json.loads(proc.stdout)
    except (ValueError, TypeError):
        return None, f"{verb} 输出非法 JSON"
    if not isinstance(resp, dict):
        return None, f"{verb} 响应不是 JSON 对象"
    got = resp.get("protocol_version")
    if got != PROTOCOL_VERSION:
        return None, f"协议主版本不匹配（期望 {PROTOCOL_VERSION}，得到 {got!r}）"
    return resp, None


# --------------------------------------------------------------------------- 配置解析与启用

def resolve_enabled(cfg):
    """返回 {adapter_name: params}。sync 段**存在**（键在合并配置里，含显式 `null` / 空 `{}`）则
    完全以其为准、绝不回落；仅当 sync 段**缺席**（键不存在）才由存量 board/github 段等价映射。"""
    if "sync" in cfg:
        sync = cfg["sync"]
        if not isinstance(sync, dict):  # 显式 null 等 → 用户显式选择零目标
            return {}
        enabled = {}
        for name, conf in sync.items():
            if isinstance(conf, dict) and conf.get("enabled"):
                enabled[name] = {k: v for k, v in conf.items() if k != "enabled"}
        return enabled

    enabled = {}
    board = cfg.get("board") or {}
    if board.get("enabled"):
        enabled["obsidian"] = {"stub_dir": board.get("stub_dir") or "board"}
    gh = cfg.get("github") or {}
    pr = gh.get("pr") or "never"
    if gh.get("issue") or pr != "never":
        enabled["github"] = {"issue": bool(gh.get("issue")), "pr": pr}
    return enabled


# --------------------------------------------------------------------------- 簿记与锁

def bookkeeping_path(cfg):
    home = os.environ.get("EO_HOME") or str(Path.home() / ".eo")
    identity = repo_identity(cfg["repo_root"])
    hash8 = hashlib.sha256(identity.encode("utf-8")).hexdigest()[:8]
    return Path(home) / "sync-state" / f"{cfg['project_name']}-{hash8}.json"


def load_bookkeeping(path):
    data = {}
    if path.is_file():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (ValueError, OSError):
            data = {}
    if not isinstance(data, dict):
        data = {}
    data.setdefault("version", 1)
    if not isinstance(data.get("adapters"), dict):
        data["adapters"] = {}
    return data


def save_bookkeeping(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(str(tmp), str(path))


def _read_lock_holder(lock_path):
    try:
        return json.loads(lock_path.read_text(encoding="utf-8"))
    except (ValueError, OSError):
        return None


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True
    return True


def _lock_is_stale(holder):
    if not isinstance(holder, dict):
        return False
    at = holder.get("at")
    pid = holder.get("pid")
    if not isinstance(at, (int, float)):
        return False
    if (time.time() - at) < STALE_LOCK_SECONDS:
        return False
    return not _pid_alive(pid)


def _try_flock(lock_path):
    """尝试非阻塞独占 flock。返回 fd（成功，已写入持有者信息）或 None（占用）。"""
    fd = os.open(str(lock_path), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    info = json.dumps({"pid": os.getpid(), "at": time.time()}, ensure_ascii=False)
    os.ftruncate(fd, 0)
    os.lseek(fd, 0, os.SEEK_SET)
    os.write(fd, info.encode("utf-8"))
    os.fsync(fd)
    return fd


def acquire_lock(lock_path):
    """取簿记同名 .lock 的独占锁。返回 (fd, None) 成功；(None, holder) 占用。陈锁自动重试一次。"""
    if fcntl is None:
        raise ConfigError("eo-sync 的并发锁依赖 POSIX fcntl.flock，当前平台不支持（可用 WSL）")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = _try_flock(lock_path)
    if fd is not None:
        return fd, None
    holder = _read_lock_holder(lock_path)
    if _lock_is_stale(holder):
        fd = _try_flock(lock_path)
        if fd is not None:
            return fd, None
    return None, holder


def release_lock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    finally:
        os.close(fd)


# --------------------------------------------------------------------------- 快照

def compute_project_root(cfg, main_wt_path):
    if cfg["mode"] == "vault":
        return cfg.get("project_root")
    return str(Path(main_wt_path) / ".eo-project")


def _read_identities(rec):
    """就地重解析 change.md frontmatter，取**标量**字段供适配器读回身份（含第三方 page_id 等）。
    列表/对象（commits/fix_consumed 等）不是身份字段，一律排除——协议 v1 快照身份值只允许标量。
    只在 eo-sync 快照层做，不污染 eo_lib 共享 rec 与 eo-board 输出。"""
    try:
        fm, _ = split_frontmatter(Path(rec["path"]).read_text(encoding="utf-8"))
    except OSError:
        fm = None
    return {k: v for k, v in (fm or {}).items() if not isinstance(v, (list, dict))}


def build_snapshot(rec, default_branch):
    ac_done, ac_total = count_ac(rec["ac"])
    todo_done, todo_total = count_todo(rec["todo"])
    try:
        rel = str(Path(rec["path"]).resolve().relative_to(Path(rec["worktree"]).resolve()))
    except ValueError:
        rel = rec["path"]
    branch = rec.get("branch")
    if branch and default_branch and branch == default_branch:
        branch = None
    return {
        "id": rec["id"],
        "seq": rec.get("seq"),
        "title": rec.get("title"),
        "summary": rec.get("summary") or "",
        "status": rec.get("status"),
        "tier": rec.get("tier") or "full",
        "type": rec.get("type") or "feature",
        "created": rec.get("created"),
        "base_commit": rec.get("base_commit"),
        "issue": rec.get("issue"),
        "pr": rec.get("pr"),
        # 已落 SoT 的全部 frontmatter 标量：适配器据此读回自己声明的身份字段（含第三方 page_id 等）
        "identities": _read_identities(rec),
        "intent": rec.get("intent") or "",
        "ac": rec.get("ac") or [],
        "todo": rec.get("todo") or [],
        "ac_done": ac_done,
        "ac_total": ac_total,
        "todo_done": todo_done,
        "todo_total": todo_total,
        "rel_path": rel,
        "branch": branch,
    }


def build_scan(cfg, anchor, change_filter, origin_wt, warnings):
    """原子扫描：**同一次** worktree 枚举 + change 消歧 + 完整性判定，返回单一结构
    ``{resolved, snapshots, complete, reasons}``。

    完整性与快照**同源同时刻**——worktrees 与降级信号来自同一次 `list_worktrees_status`，扫描告警
    在同一遍统计；每次调用（含锁内复扫）都由本函数一并算出，杜绝「旧判定配新快照 / 新判定配旧快照」。
    ``complete=True`` 仅当同时满足：无选择性过滤、扫描/消歧零告警（解析失败·撞号·分叉）、worktree 枚举未降级。
    权威 rec 由 resolve_change 一次选定，计划快照与身份回写落点共用同一份。
    """
    mark = len(warnings)
    worktrees, enum_ok = list_worktrees_status(anchor)
    default_branch = worktrees[0].get("branch") if worktrees else None
    grouped = scan_changes_grouped(cfg, worktrees, warnings)
    resolved, snapshots = {}, []
    for cid in sorted(grouped):
        if change_filter and cid != change_filter:
            continue
        rec, cands = resolve_change(grouped[cid], origin_wt)
        if rec is None:
            warnings.append(f"change {cid} 同状态内容分叉，计划与回写均跳过：{', '.join(cands or [])}")
            continue
        resolved[cid] = rec
        snapshots.append(build_snapshot(rec, default_branch))
    scan_clean = len(warnings) == mark
    reasons = []
    if change_filter is not None:
        reasons.append("选择性过滤")
    if not scan_clean:
        reasons.append("扫描告警")
    if not enum_ok:
        reasons.append("worktree 枚举降级")
    return {"resolved": resolved, "snapshots": snapshots, "complete": not reasons, "reasons": reasons}


def _warn_incomplete(scan, warnings):
    if not scan["complete"]:
        warnings.append(
            f"快照不可证完整（{' / '.join(scan['reasons'])}），本轮跳过孤儿投影清理以防误删范围外投影"
        )


# --------------------------------------------------------------------------- 适配器排序与 capabilities

def load_capabilities(adapters, warnings):
    """对每个 {name: path} 查 capabilities。返回 {name: {"path", "caps"}}；失败者告警并剔除。"""
    result = {}
    for name in sorted(adapters):
        path = adapters[name]
        resp, err = invoke_adapter(path, "capabilities", {}, timeout=20)
        if err:
            warnings.append(f"适配器 {name} capabilities 失败，已跳过：{err}")
            continue
        result[name] = {"path": path, "caps": resp}
    return result


def validate_identity_ownership(loaded, warnings):
    """校验各适配器 identity_fields：命名合法、非保留键、跨适配器无同名冲突。返回被拒绝的 name 集合。"""
    rejected = set()
    for name, info in loaded.items():
        fields = info["caps"].get("identity_fields") or []
        if not isinstance(fields, list):
            warnings.append(f"适配器 {name} 的 identity_fields 不是列表，已拒绝")
            rejected.add(name)
            continue
        for f in fields:
            if not isinstance(f, str) or not FIELD_NAME_RE.match(f):
                warnings.append(f"适配器 {name} 声明非法身份字段名 {f!r}，已拒绝")
                rejected.add(name)
                break
            if f in RESERVED_CHANGE_KEYS:
                warnings.append(f"适配器 {name} 声明保留键 {f!r} 作身份字段，已拒绝")
                rejected.add(name)
                break

    owner = {}
    for name, info in loaded.items():
        if name in rejected:
            continue
        for f in info["caps"].get("identity_fields") or []:
            owner.setdefault(f, []).append(name)
    for f, names in owner.items():
        if len(names) > 1:
            warnings.append(f"身份字段 {f!r} 被多个适配器声明（{', '.join(sorted(names))}），全部拒绝以 fail-closed")
            rejected.update(names)
    return rejected


# --------------------------------------------------------------------------- run

def _project_context(cfg, project_root):
    return {
        "project_name": cfg["project_name"],
        "project_root": project_root,
        "doc_root": cfg["doc_root"],
        "repo_root": str(cfg["repo_root"]),
    }


def apply_writeback(writeback, identity_fields, resolved, warnings):
    """核执行身份字段回写校验 + 保序落盘。落点 = resolved 里同一份权威 rec，不再重新推导。
    返回实际写入的 {path: {field: value}}。"""
    fields_set = set(identity_fields)
    per_path = {}
    for cid, fields in (writeback or {}).items():
        if not isinstance(fields, dict):
            continue
        rec = resolved.get(cid)
        if rec is None:
            warnings.append(f"回写目标 change 不在本次范围或已 fail-closed：{cid}，已跳过")
            continue
        accepted = {}
        for field, value in fields.items():
            if value is None:
                continue
            if field not in fields_set:
                warnings.append(f"回写字段 {field!r} 未在适配器 identity_fields 声明（change {cid}），已拒绝")
                continue
            if not FIELD_NAME_RE.match(str(field)) or field in RESERVED_CHANGE_KEYS:
                warnings.append(f"回写字段 {field!r} 非法或为保留键（change {cid}），已拒绝")
                continue
            accepted[field] = value
        if not accepted:
            continue
        path = rec["path"]
        try:
            existing_fm, _ = split_frontmatter(Path(path).read_text(encoding="utf-8"))
        except OSError as e:
            warnings.append(f"回写读取失败（change {cid}）：{e}")
            continue
        existing_fm = existing_fm or {}
        final = {}
        for field, value in accepted.items():
            cur = existing_fm.get(field)
            if cur not in (None, "") and str(cur) != str(value):
                warnings.append(f"字段 {field} 已有不同非空值（{cur!r}），不覆盖（change {cid}）")
                continue
            if str(cur) == str(value):
                continue  # 已是目标值，幂等跳过
            final[field] = value
        if final:
            per_path.setdefault(path, {}).update(final)

    for path, fields in per_path.items():
        try:
            text = Path(path).read_text(encoding="utf-8")
            Path(path).write_text(upsert_frontmatter_fields(text, fields), encoding="utf-8")
        except OSError as e:
            warnings.append(f"回写落盘失败：{path}（{e}）")
    return per_path


VALID_OPS = {"create", "update", "delete", "skip"}


def _validate_plan_response(resp):
    if "actions" not in resp:
        return "plan 响应缺少必填字段 actions"
    actions = resp["actions"]
    if not isinstance(actions, list):
        return "plan.actions 不是列表"
    for a in actions:
        if not isinstance(a, dict):
            return "plan.actions 含非对象元素"
        for key in ("op", "change_id", "projection"):
            if key not in a:
                return f"plan.action 缺少必填字段 {key}"
        if a["op"] not in VALID_OPS:
            return f"plan.action.op 非法：{a.get('op')!r}"
        if not isinstance(a["change_id"], str):
            return "plan.action.change_id 不是字符串"
        if not isinstance(a["projection"], str):
            return "plan.action.projection 不是字符串"
    drift = resp.get("drift")
    if drift is not None and not isinstance(drift, list):
        return "plan.drift 不是列表"
    return None


def _validate_apply_response(resp):
    if "results" not in resp:
        return "apply 响应缺少必填字段 results"
    results = resp["results"]
    if not isinstance(results, list):
        return "apply.results 不是列表"
    for r in results:
        if not isinstance(r, dict):
            return "apply.results 含非对象元素"
        for key in ("change_id", "op"):
            if key not in r:
                return f"apply.result 缺少必填字段 {key}"
    if "bookkeeping" not in resp:
        return "apply 响应缺少必填字段 bookkeeping"
    if not isinstance(resp["bookkeeping"], dict):
        return "apply.bookkeeping 不是对象"
    if "writeback" not in resp:
        return "apply 响应缺少必填字段 writeback"
    wb = resp["writeback"]
    if not isinstance(wb, dict):
        return "apply.writeback 不是对象"
    for cid, fields in wb.items():
        if not isinstance(fields, dict):
            return f"apply.writeback[{cid}] 不是对象"
        for k, v in fields.items():
            if isinstance(v, (dict, list)):
                return f"apply.writeback[{cid}][{k}] 不是标量"
    drift = resp.get("drift")
    if drift is not None and not isinstance(drift, list):
        return "apply.drift 不是列表"
    return None


def _display_from_actions(actions):
    return [{"change_id": a.get("change_id"), "projection": a.get("projection", "?"),
             "op": a.get("op", "?"), "reason": a.get("reason", "")} for a in actions]


def _display_from_results(results):
    """run 模式以实际 apply 结果作显示：跳过/失败原因如实呈现，不复述计划意图。"""
    items = []
    for r in results:
        op = r.get("op", "?")
        if r.get("skipped"):
            reason, op = r.get("note", "已跳过"), "skip"
        elif r.get("error"):
            reason = f"失败：{r.get('error')}"
        else:
            reason = r.get("note", "")
        items.append({"change_id": r.get("change_id"), "projection": r.get("projection", "?"),
                      "op": op, "reason": reason})
    return items


def run_adapter_phase(name, info, context, snapshots, book_ns, params, dry_run, snapshot_complete, warnings):
    """跑单个适配器的 plan（+ 非 dry-run 时 apply）。返回 (display_items, writeback, new_ns, drift, ok)。

    display_items：dry-run 取计划动作、run 取实际 apply 结果（含 skipped/error 原因）。
    结构校验失败按该适配器失败隔离（ok=False），不中断其它目标。
    """
    plan_req = {
        "context": context,
        "changes": snapshots,
        "bookkeeping": book_ns,
        "params": params,
        "snapshot_complete": snapshot_complete,
    }
    plan, err = invoke_adapter(info["path"], "plan", plan_req, timeout=90)
    if err:
        warnings.append(f"适配器 {name} plan 失败，已跳过：{err}")
        return [], {}, book_ns, [], False
    err = _validate_plan_response(plan)
    if err:
        warnings.append(f"适配器 {name} plan 响应结构非法，已跳过：{err}")
        return [], {}, book_ns, [], False
    actions = plan.get("actions") or []
    drift = plan.get("drift") or []
    if dry_run:
        return _display_from_actions(actions), {}, book_ns, drift, True

    apply_req = {
        "context": context,
        "actions": actions,
        "bookkeeping": book_ns,
        "params": params,
    }
    result, err = invoke_adapter(info["path"], "apply", apply_req, timeout=300)
    if err:
        warnings.append(f"适配器 {name} apply 失败，已跳过：{err}")
        return _display_from_actions(actions), {}, book_ns, drift, False
    err = _validate_apply_response(result)
    if err:
        warnings.append(f"适配器 {name} apply 响应结构非法，已跳过：{err}")
        return _display_from_actions(actions), {}, book_ns, drift, False
    writeback = result.get("writeback") or {}
    new_ns = result.get("bookkeeping")
    if not isinstance(new_ns, dict):
        new_ns = book_ns
    drift = (drift or []) + (result.get("drift") or [])
    results = result.get("results") or []
    ok = not any(isinstance(r, dict) and r.get("error") for r in results)
    return _display_from_results(results), writeback, new_ns, drift, ok


def cmd_run(cfg, args):
    warnings = []
    failure = False
    dry_run = args.dry_run

    anchor = str(cfg["repo_root"])
    worktrees = list_worktrees(anchor)
    main_wt = worktrees[0]
    project_root = compute_project_root(cfg, main_wt["path"])
    context = _project_context(cfg, project_root)
    origin_wt = str(Path(cfg["repo_root"]).resolve())

    enabled = resolve_enabled(cfg)
    if args.target:
        enabled = {k: v for k, v in enabled.items() if k == args.target}
    if not enabled:
        print("未启用任何同步目标（合并配置无 sync 段且无 board/github 联动，或 --target 未命中）。")
        return EXIT_OK

    discovered = discover_adapters()
    loaded = load_capabilities({n: p for n, p in discovered.items() if n in enabled}, warnings)
    for name in enabled:
        if name not in loaded:
            warnings.append(f"启用的适配器 {name} 未在 PATH 发现或 capabilities 不可用，已跳过")
            failure = True

    rejected = validate_identity_ownership(loaded, warnings)
    for name in rejected:
        failure = True
        loaded.pop(name, None)

    active = [n for n in enabled if n in loaded]
    if not active:
        _emit_warnings(warnings)
        print("无可用同步目标（启用的适配器均不可用）。")
        return EXIT_FAILURE if failure else EXIT_OK

    # 两阶段：身份字段适配器先行，回写并刷新快照后再跑纯投影适配器
    identity_first = sorted(n for n in active if (loaded[n]["caps"].get("identity_fields") or []))
    pure_after = sorted(n for n in active if not (loaded[n]["caps"].get("identity_fields") or []))

    lock_fd = None
    bk_path = bookkeeping_path(cfg)
    if not dry_run:
        lock_fd, holder = acquire_lock(Path(str(bk_path) + ".lock"))
        if lock_fd is None:
            _emit_warnings(warnings)
            hint = ""
            if isinstance(holder, dict):
                when = holder.get("at")
                when_s = datetime.fromtimestamp(when).strftime("%Y-%m-%d %H:%M:%S") if isinstance(when, (int, float)) else "?"
                hint = f"（持有者 pid={holder.get('pid')}，取锁于 {when_s}）"
            print(f"⏸ 另一个 eo-sync run 正持锁{hint}，本次干净退出。稍后重跑。", file=sys.stderr)
            return EXIT_LOCKED

    # 孤儿删除只在「快照可证完整」时执行：build_scan 把 worktree 枚举 + 扫描 + 完整性判定绑成原子结果，
    # snapshot 与 complete 同源同时刻；锁内每次（含复扫）都由 build_scan 一并重算，绝不旧判定配新快照（fail-safe）
    try:
        book = load_bookkeeping(bk_path)
        scan = build_scan(cfg, anchor, args.change, origin_wt, warnings)
        _warn_incomplete(scan, warnings)

        all_display = []  # (change_id, adapter, item)
        all_drift = []

        # 阶段一
        wrote_back = False
        for name in identity_first:
            info = loaded[name]
            book_ns = book["adapters"].get(name, {})
            params = enabled[name]
            display, writeback, new_ns, drift, ok = run_adapter_phase(
                name, info, context, scan["snapshots"], book_ns, params, dry_run, scan["complete"], warnings
            )
            if not ok:
                failure = True
            for d in display:
                all_display.append((d.get("change_id"), name, d))
            all_drift.extend(f"[{name}] {d}" for d in drift)
            if not dry_run:
                book["adapters"][name] = new_ns
                identity_fields = info["caps"].get("identity_fields") or []
                written = apply_writeback(writeback, identity_fields, scan["resolved"], warnings)
                if written:
                    wrote_back = True

        # 回写后复扫：快照与其完整性由同一次 build_scan 一并重算，令纯投影适配器读到新平台身份
        if wrote_back and not dry_run:
            was_complete = scan["complete"]
            scan = build_scan(cfg, anchor, args.change, origin_wt, warnings)
            if was_complete and not scan["complete"]:
                _warn_incomplete(scan, warnings)

        # 阶段二
        for name in pure_after:
            info = loaded[name]
            book_ns = book["adapters"].get(name, {})
            params = enabled[name]
            display, writeback, new_ns, drift, ok = run_adapter_phase(
                name, info, context, scan["snapshots"], book_ns, params, dry_run, scan["complete"], warnings
            )
            if not ok:
                failure = True
            for d in display:
                all_display.append((d.get("change_id"), name, d))
            all_drift.extend(f"[{name}] {d}" for d in drift)
            if not dry_run:
                book["adapters"][name] = new_ns
                if writeback:
                    warnings.append(f"适配器 {name} 无身份字段却返回回写，已忽略")

        if not dry_run:
            save_bookkeeping(bk_path, book)
    finally:
        if lock_fd is not None:
            release_lock(lock_fd)

    _emit_plan(all_display, all_drift, active, dry_run)
    _emit_warnings(warnings)
    return EXIT_FAILURE if failure else EXIT_OK


def _emit_plan(all_display, all_drift, active, dry_run):
    header = "eo-sync run --dry-run（提示性计划，落地以持锁重算为准）" if dry_run else "eo-sync run 结果"
    print(header)
    if not all_display:
        print(f"  （启用目标 {', '.join(active)}：无{'计划' if dry_run else '执行'}动作）")
    counts = {}
    for cid, adapter, item in sorted(all_display, key=lambda t: (str(t[0]), t[1], str(t[2].get("projection")))):
        op = item.get("op", "?")
        proj = item.get("projection", "?")
        reason = item.get("reason", "")
        counts[op] = counts.get(op, 0) + 1
        tail = f"（{reason}）" if reason else ""
        print(f"  {cid} × {adapter}/{proj} → {op}{tail}")
    if counts:
        print("  小计：" + "，".join(f"{op} {n}" for op, n in sorted(counts.items())))
    for d in all_drift:
        print(f"  ⚠ 漂移：{d}")


def _emit_warnings(warnings):
    for w in warnings:
        print(f"  ! {w}", file=sys.stderr)


# --------------------------------------------------------------------------- adapters

def cmd_adapters(cfg, args):
    warnings = []
    enabled = resolve_enabled(cfg)
    discovered = discover_adapters()
    if not discovered:
        print("PATH 上未发现任何 eo-sync-* 适配器。")
        return EXIT_OK
    print("已发现的 eo-sync 适配器：")
    for name in sorted(discovered):
        path = discovered[name]
        flag = "启用" if name in enabled else "未启用"
        resp, err = invoke_adapter(path, "capabilities", {}, timeout=20)
        if err:
            print(f"  {name}  [{flag}]  {path}\n      capabilities 不可用：{err}")
            continue
        projections = resp.get("projections") or []
        proj_desc = ", ".join(
            f"{p.get('id')}（起点 {p.get('lifecycle_start')}）" for p in projections if isinstance(p, dict)
        )
        idf = resp.get("identity_fields") or []
        idf_desc = f"；身份字段 {idf}" if idf else ""
        print(f"  {name}  [{flag}]  {path}")
        print(f"      投影：{proj_desc or '无'}{idf_desc}")
    for name in enabled:
        if name not in discovered:
            print(f"  （配置启用了 {name}，但 PATH 上无 eo-sync-{name}）")
    return EXIT_OK


# --------------------------------------------------------------------------- watch

def _watch_warn(state, project_key, fingerprint, message):
    """（项目, 错误指纹）级告警抑制：同一故障常驻期间只告警一次，不逐轮刷屏。"""
    token = (project_key, fingerprint)
    if token in state["suppressed"]:
        return
    state["suppressed"].add(token)
    print(message, file=sys.stderr)


def _clear_suppression(state, project_key, prefix=None):
    """清除某项目的抑制记录；prefix 给定时只清该错误类（如 "cfg:"），其余类保持抑制。"""
    state["suppressed"] = {
        t for t in state["suppressed"]
        if t[0] != project_key or (prefix is not None and not t[1].startswith(prefix))
    }


def _run_once(cfg):
    return cmd_run(cfg, argparse.Namespace(dry_run=False, change=None, target=None))


def _watch_key(cfg):
    """watch 基线键 = freshness 键 + 合并配置指纹——配置变更（sync 段/适配器参数/local 覆盖）
    不在 freshness 键覆盖面内，必须并入基线才不会被短路吞掉。"""
    fingerprint = json.dumps(cfg, sort_keys=True, ensure_ascii=False, default=str)
    return (compute_freshness_key(cfg), fingerprint)


def watch_project_tick(state, label, cfg_path, runner=_run_once):
    """单项目单轮：基线键（freshness + 配置指纹）比对短路；键变则进程内调用既有 run 编排。

    结果矩阵：退出 0/1 → run 后重算键记基线（吸收 identity 回写的 mtime 变化，防自触发循环；
    部分失败同样记基线，防对持续性故障忙循环）；2（锁占用）→ 不记基线，打一行跳过提示；
    异常（含 run 后重算异常）→ 不记基线，按（项目, 错误指纹）抑制告警。首轮无基线视为键已变；
    配置故障轮丢弃旧基线，恢复轮必然重新 run 并借成功路径清空抑制。
    """
    key_id = str(cfg_path)
    try:
        cfg = load_project_config(cfg_path)
        fkey = _watch_key(cfg)
    except ConfigError as e:
        state["baselines"].pop(key_id, None)
        _watch_warn(state, key_id, f"cfg:{e}", f"[eo-sync watch] ⚠ {label}：{e}（已跳过，修复后自动恢复）")
        return
    except Exception as e:
        state["baselines"].pop(key_id, None)
        _watch_warn(state, key_id, f"cfg:{type(e).__name__}:{e}", f"[eo-sync watch] ⚠ {label}：加载失败（{e}），已跳过")
        return
    _clear_suppression(state, key_id, prefix="cfg:")
    if state["baselines"].get(key_id) == fkey:
        return
    try:
        rc = runner(cfg)
    except Exception as e:
        _watch_warn(state, key_id, f"run:{type(e).__name__}:{e}", f"[eo-sync watch] ⚠ {label}：run 异常（{e}），下一轮重试")
        return
    if rc == EXIT_LOCKED:
        print(f"[eo-sync watch] ⏸ {label}：锁被占用，本轮跳过，下一轮自动追平", file=sys.stderr)
        return
    try:
        new_key = _watch_key(cfg)
    except Exception as e:
        _watch_warn(state, key_id, f"run:recompute:{type(e).__name__}:{e}",
                    f"[eo-sync watch] ⚠ {label}：run 后基线重算失败（{e}），下一轮重试")
        return
    state["baselines"][key_id] = new_key
    _clear_suppression(state, key_id)
    tail = "" if rc == EXIT_OK else "（部分失败，详见上方告警；下一轮无新变化时静默）"
    print(f"[eo-sync watch] ✓ {label} 已同步 @ {datetime.now().strftime('%H:%M:%S')}{tail}", file=sys.stderr)


def watch_scope(state, args, bare_cfg_path=None):
    """算本轮作用域 [(label, cfg_path)]。--all 每轮重读注册表（watch 期间新注册项目下一轮即纳入）；
    单项目故障只影响该行，循环与其余项目不受影响。"""
    if args.all:
        try:
            reg = load_registry()
        except ConfigError as e:
            _watch_warn(state, "<registry>", f"corrupt:{e}", f"[eo-sync watch] ⚠ {e}")
            return []
        state["suppressed"] = {t for t in state["suppressed"]
                               if not (t[0] == "<registry>" and t[1].startswith("corrupt:"))}
        entries = reg.get("projects") or []
        if not entries:
            _watch_warn(state, "<registry>", "empty",
                        f"[eo-sync watch] 注册表为空（{registry_path()}）——在项目目录运行 eo-board --register 注册后自动纳入")
            return []
        state["suppressed"].discard(("<registry>", "empty"))
        scope = []
        for entry in entries:
            if entry_path(entry) is None:
                _watch_warn(state, "<registry>", f"entry:{entry!r}",
                            f"[eo-sync watch] ⚠ 注册条目非法（path 缺失或不是字符串），已跳过：{entry!r}")
                continue
            path = Path(entry["path"])
            cfg_path = path / ".eo-project.json"
            if not cfg_path.is_file():
                _watch_warn(state, str(path), "missing-config",
                            f"[eo-sync watch] ⚠ {entry.get('name') or path.name}：路径失效或缺 .eo-project.json（{path}），已跳过")
                continue
            state["suppressed"].discard((str(path), "missing-config"))
            scope.append((entry.get("name") or path.name, cfg_path))
        return scope
    if args.project:
        start = Path(args.project).expanduser().resolve()
        cfg_path = find_project_config(start)
        if cfg_path is None:
            _watch_warn(state, str(start), "missing-config",
                        f"[eo-sync watch] ⚠ 未找到 .eo-project.json（自 {start} 向上），已跳过")
            return []
        state["suppressed"].discard((str(start), "missing-config"))
        return [(cfg_path.parent.name, cfg_path)]
    return [(bare_cfg_path.parent.name, bare_cfg_path)]


def cmd_watch(args, bare_cfg_path=None):
    if args.interval < 1:
        print("❌ --interval 下限为 1 秒", file=sys.stderr)
        return EXIT_FAILURE
    state = {"baselines": {}, "suppressed": set()}

    def _sigterm(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, _sigterm)
    if args.all:
        scope_desc = f"--all（{registry_path()}）"
    elif args.project:
        scope_desc = f"--project {args.project}"
    else:
        scope_desc = str(bare_cfg_path.parent)
    print(f"eo-sync watch 已启动（间隔 {args.interval:g}s · 作用域 {scope_desc}；Ctrl+C 停止）", file=sys.stderr)
    try:
        while True:
            for label, cfg_path in watch_scope(state, args, bare_cfg_path):
                watch_project_tick(state, label, cfg_path)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        print("\neo-sync watch 已停止。", file=sys.stderr)
        return EXIT_OK


# --------------------------------------------------------------------------- 入口

def build_arg_parser():
    parser = argparse.ArgumentParser(
        prog="eo-sync",
        description="eo-skills 投影同步的插件化核：发现 eo-sync-* 适配器，持锁编排一次单向同步。",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command")

    p_run = sub.add_parser("run", help="执行一次同步（默认落地；--dry-run 只算不写）")
    p_run.add_argument("--dry-run", action="store_true", help="只输出提示性计划，全程零写入、不取锁")
    p_run.add_argument("--change", metavar="ID", help="只同步指定 change id")
    p_run.add_argument("--target", metavar="NAME", help="只跑指定适配器")

    sub.add_parser("adapters", help="列出 PATH 上发现的适配器与其 capabilities")

    p_watch = sub.add_parser("watch", help="常驻轮询：freshness 键变才 run，键不变零成本跳过")
    p_watch.add_argument("--interval", type=float, default=10.0, metavar="N",
                         help="轮询间隔秒数（默认 10，下限 1）")
    scope = p_watch.add_mutually_exclusive_group()
    scope.add_argument("--all", action="store_true", help="追平注册表全部项目（每轮重读，无需在项目内运行）")
    scope.add_argument("--project", metavar="PATH", help="只追平指定路径的项目（无需 cd）")
    return parser


def main(argv=None):
    parser = build_arg_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return EXIT_OK

    # watch --all / --project 是显式作用域，不要求 cwd 在任何项目内；裸 watch 沿用 cwd 解析与既有报错
    if args.command == "watch" and (args.all or args.project):
        return cmd_watch(args)

    cfg_path = find_project_config(Path.cwd())
    if cfg_path is None:
        print("❌ 未找到 .eo-project.json", file=sys.stderr)
        print("请先运行 /eo-project-init 初始化项目。", file=sys.stderr)
        return EXIT_FAILURE
    try:
        cfg = load_project_config(cfg_path)
    except ConfigError as e:
        print(f"❌ {e}", file=sys.stderr)
        print("请检查配置或运行 /eo-project-init 修复。", file=sys.stderr)
        return EXIT_FAILURE

    try:
        if args.command == "run":
            return cmd_run(cfg, args)
        if args.command == "adapters":
            return cmd_adapters(cfg, args)
        if args.command == "watch":
            return cmd_watch(args, bare_cfg_path=cfg["config_path"])
    except ConfigError as e:
        print(f"❌ {e}", file=sys.stderr)
        return EXIT_FAILURE
    parser.print_help()
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
